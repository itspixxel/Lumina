<UserControl x:Class="Lumina.Views.GalleryView" Focusable="True" FocusVisualStyle="{x:Null}"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Lumina.Views">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="ThumbButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="v:Fx.HoverLift" Value="3" />
            <Setter Property="v:Fx.PressScale" Value="0.97" />
            <Setter Property="Margin" Value="0,0,14,14" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Width="200">
                            <Border CornerRadius="12" BorderThickness="1"
                                    Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource StrokeBrush}" />
                            <Border CornerRadius="12" BorderThickness="1" Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource StrokeStrongBrush}"
                                    Opacity="0" v:Fx.Show="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Border CornerRadius="12" Background="{StaticResource AccentSoftBrush}" Opacity="0"
                                    v:Fx.Show="{Binding IsSelected}" />
                            <ContentPresenter Margin="7" />
                            <!-- Drawn on top so the 2px selected ring doesn't shift the content. -->
                            <Border CornerRadius="12" BorderThickness="2" BorderBrush="{StaticResource AccentBrush}"
                                    IsHitTestVisible="False" Opacity="0" v:Fx.Show="{Binding IsSelected}" />
                            <!-- The keyboard cursor: an inner ring in the gap around the thumbnail, so nothing clips it and it
                                 still shows on a selected tile. -->
                            <Border CornerRadius="9" BorderThickness="1.5" BorderBrush="{StaticResource TextBrush}" Margin="3"
                                    IsHitTestVisible="False" Opacity="0" v:Fx.ShowOpacity="0.75" v:Fx.Show="{Binding IsCurrent}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- The round checkbox in a tile's corner: hidden until hover, or while anything is selected. -->
        <Style x:Key="SelectDot" TargetType="Border">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Margin" Value="8" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="#E6FFFFFF" />
            <Setter Property="Background" Value="#66000000" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="v:Fx.PressScale" Value="0.85" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                    <Setter Property="v:Fx.Show" Value="True" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelecting, RelativeSource={RelativeSource AncestorType=v:GalleryView}}" Value="True">
                    <Setter Property="v:Fx.Show" Value="True" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#99000000" />
                    <Setter Property="BorderBrush" Value="White" />
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="v:Fx.Show" Value="True" />
                    <Setter Property="Background" Value="{StaticResource AccentGradient}" />
                    <Setter Property="BorderBrush" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="TileTemplate">
            <Button Style="{StaticResource ThumbButton}" Click="Tile_Click" ToolTip="{Binding Details}"
                    ContextMenuOpening="Tile_ContextMenuOpening" Loaded="Tile_Loaded" Unloaded="Tile_Unloaded">
                <StackPanel>
                    <Grid>
                        <Border Height="112" CornerRadius="8" Background="{StaticResource WindowBrush}" ClipToBounds="True">
                            <Image Source="{Binding Thumb}" Stretch="Uniform" Margin="2" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <Border Width="34" Height="34" CornerRadius="17" Background="#A61C1B29" BorderBrush="#40FFFFFF" BorderThickness="1"
                                HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                Visibility="{Binding IsVideo, Converter={StaticResource BoolToVisibility}}">
                            <Path Data="{StaticResource IconPlay}" Fill="White" Stretch="Uniform" Width="11" Height="12" Margin="3,0,0,0" />
                        </Border>
                        <Border Style="{StaticResource SelectDot}" PreviewMouseLeftButtonDown="SelectDot_MouseDown"
                                ToolTip="Select - Ctrl+click to add, Shift+click for a range">
                            <Path Data="M5.5,10.2 L8.6,13.3 L14.5,7.2" Stroke="White" StrokeThickness="2.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Opacity="0" v:Fx.ShowPop="True" v:Fx.Show="{Binding IsSelected}" />
                        </Border>
                    </Grid>
                    <Grid Margin="4,8,4,0">
                        <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                            <Setter Property="Visibility" Value="Hidden" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBox FontSize="12" Padding="4,1" Margin="-5,-3" Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisibility}}"
                                 IsVisibleChanged="RenameBox_IsVisibleChanged" KeyDown="RenameBox_KeyDown"
                                 LostKeyboardFocus="RenameBox_LostKeyboardFocus" />
                    </Grid>
                    <TextBlock Text="{Binding Info}" FontSize="11" Margin="4,1,4,4" Foreground="{StaticResource Text3Brush}" />
                </StackPanel>
            </Button>
        </DataTemplate>
        <DataTemplate DataType="{x:Type v:GalleryTileRow}">
            <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource TileTemplate}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </DataTemplate>
        <DataTemplate DataType="{x:Type v:GalleryHeaderRow}">
            <StackPanel Orientation="Horizontal" Margin="{Binding Margin}">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                <TextBlock Text="{Binding CountText}" FontSize="12" Foreground="{StaticResource Text3Brush}" Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,4" MinHeight="40">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Text="Gallery" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <Button x:Name="ViewAllButton" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Padding="8,4" VerticalAlignment="Center"
                        Click="ViewAll_Click" ToolTip="Open the full gallery with search (Ctrl+F)" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="ViewAllText" Text="View all" FontSize="12" VerticalAlignment="Center" />
                        <Path Data="M9,6 L15,12 L9,18" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="12" Height="12" Stretch="Uniform"
                              Margin="4,1,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBlock x:Name="RecentHint" Text="Click to open, Ctrl or Shift+click to select" FontSize="12"
                       VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{StaticResource Text3Brush}" />

            <!-- Selection actions, shown while anything is selected -->
            <Border x:Name="SelectionBar" Style="{StaticResource Pill}" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Padding="12,3,4,3" Visibility="Collapsed" Effect="{x:Null}">
                <StackPanel Orientation="Horizontal">
                    <Border Width="18" Height="18" CornerRadius="9" Background="{StaticResource AccentGradient}" VerticalAlignment="Center">
                        <Path Data="M5,9.5 L8,12.5 L13.5,6.5" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    </Border>
                    <TextBlock x:Name="SelectionText" Text="1 selected" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,10,0" />
                    <Rectangle Style="{StaticResource VDivider}" />
                    <Button Style="{StaticResource IconButton}" Click="SelectAll_Click" ToolTip="Select all (Ctrl+A)">
                        <TextBlock Text="All" FontSize="12" Margin="2,0" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Click="SelectionCopy_Click" ToolTip="Copy (Ctrl+C)">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconCopy}" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Click="SelectionFolder_Click" ToolTip="Show in folder (Ctrl+E)">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconFolder}" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Click="SelectionDelete_Click" ToolTip="Move to Recycle Bin (Del), Shift+Del deletes permanently"
                            Foreground="{StaticResource DangerBrush}">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconTrash}" />
                    </Button>
                    <Rectangle Style="{StaticResource VDivider}" />
                    <Button Style="{StaticResource IconButton}" Click="SelectionClear_Click" ToolTip="Clear selection (Esc)">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconClose}" />
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <!-- Rows of tiles (and date headers), virtualized so thousands of files stay fast. -->
            <ItemsControl x:Name="RecentList" Margin="0,0,-12,0" Focusable="False"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Standard"
                          VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      CanContentScroll="True" Focusable="False">
                            <!-- Top space inside the scroll area, so a hovered tile can lift without its top edge being cut off. -->
                            <ItemsPresenter Margin="0,8,0,20" />
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
            <StackPanel x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"
                        v:Fx.Entrance="True" v:Fx.EntranceDelay="200">
                <Border Width="56" Height="56" CornerRadius="16" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
                        HorizontalAlignment="Center">
                    <Path x:Name="EmptyIcon" Style="{StaticResource Icon}" Data="{StaticResource IconRegion}" Stroke="{StaticResource AccentTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="EmptyTitle" Text="Your captures show up here" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,4" />
                <TextBlock x:Name="EmptyHintText" Text="Use your capture shortcut, or pick a mode above." Foreground="{StaticResource Text2Brush}" HorizontalAlignment="Center" />
                <Button x:Name="ClearFiltersButton" Content="Clear search and filters" HorizontalAlignment="Center" Margin="0,14,0,0"
                        Click="ClearFilters_Click" Visibility="Collapsed" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
