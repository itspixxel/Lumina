<v:ChromeWindow x:Class="Lumina.Views.VideoEditorWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:v="clr-namespace:Lumina.Views"
                Title="Lumina Recording" Width="1080" Height="760" MinWidth="720" MinHeight="500"
                WindowStartupLocation="CenterScreen" Icon="/Assets/lumina.ico"
                PreviewKeyDown="Window_PreviewKeyDown">
    <v:ChromeWindow.Resources>
        <Style x:Key="BarLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource Text2Brush}" />
        </Style>
        <Style x:Key="ChipToggle" TargetType="ToggleButton" BasedOn="{StaticResource ToolToggle}">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="v:Fx.PressScale" Value="0.94" />
        </Style>
        <Style x:Key="ChipIcon" TargetType="Path" BasedOn="{StaticResource Icon}">
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="LayoutTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="0.6" ScaleY="0.6" />
                </Setter.Value>
            </Setter>
        </Style>
    </v:ChromeWindow.Resources>

    <v:ChromeWindow.TitleBarContent>
        <StackPanel Orientation="Horizontal">
            <Button Style="{StaticResource IconButton}" Click="ShowInFolder_Click" ToolTip="Show in folder (Ctrl+E)">
                <Path Style="{StaticResource Icon}" Data="{StaticResource IconFolder}" />
            </Button>
            <Button Style="{StaticResource IconButton}" Click="Delete_Click" ToolTip="Move to Recycle Bin (Del) · Shift+Del deletes permanently" Margin="2,0,0,0"
                    Foreground="{StaticResource DangerBrush}">
                <Path Style="{StaticResource Icon}" Data="{StaticResource IconTrash}" />
            </Button>
        </StackPanel>
    </v:ChromeWindow.TitleBarContent>

    <Grid Margin="24,4,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Video -->
        <Border Grid.Row="0" CornerRadius="12" Background="#07060C" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
                ClipToBounds="True" MouseLeftButtonDown="Video_MouseDown" Cursor="Hand">
            <Grid>
                <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Close" ScrubbingEnabled="True"
                              Stretch="Uniform" Margin="1" MediaOpened="Player_MediaOpened" MediaFailed="Player_MediaFailed"
                              MediaEnded="Player_MediaEnded" />
                <Border x:Name="BigPlay" Width="64" Height="64" CornerRadius="32" Background="#A61C1B29"
                        BorderBrush="#40FFFFFF" BorderThickness="1" IsHitTestVisible="False"
                        HorizontalAlignment="Center" VerticalAlignment="Center" v:Fx.Show="True">
                    <Path Data="{StaticResource IconPlay}" Fill="White" Stretch="Uniform" Width="20" Height="22" Margin="5,0,0,0" />
                </Border>
                <TextBlock x:Name="LoadingText" Text="Loading…" Foreground="{StaticResource Text2Brush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <!-- Messages and export progress -->
                <v:Toast x:Name="Toast" VerticalAlignment="Bottom" Margin="16,0,16,16" />
            </Grid>
        </Border>

        <!-- Transport + timeline -->
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="PlayButton" Grid.Column="0" Style="{StaticResource AccentButton}" Width="48" Height="48" Padding="0"
                    VerticalAlignment="Center" Click="Play_Click" ToolTip="Play (Space)" Margin="0,0,14,0">
                <Path x:Name="PlayIcon" Data="{StaticResource IconPlay}" Fill="White" Stretch="Uniform" Width="14" Height="16" Margin="3,0,0,0" />
            </Button>
            <v:TrimTimeline x:Name="Timeline" Grid.Column="1" VerticalAlignment="Center"
                            ToolTip="Drag the ends to trim · I and O set them at the playhead · ← → step, Shift for 5 s" />
        </Grid>

        <!-- Times + actions. The actions drop to their own line when the window is too narrow for both. -->
        <Grid x:Name="BottomBar" Grid.Row="2" Margin="0,14,0,0" SizeChanged="BottomBar_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel x:Name="TimeGroup" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="TimeText" Text="0:00.0" FontFamily="Cascadia Mono, Consolas" FontSize="13" VerticalAlignment="Center" />
                <TextBlock x:Name="DurationText" Text=" / 0:00.0" FontFamily="Cascadia Mono, Consolas" FontSize="13"
                           Foreground="{StaticResource Text3Brush}" VerticalAlignment="Center" />
                <Border x:Name="TrimBadge" Margin="12,0,0,0" CornerRadius="7" Padding="9,3" Background="{StaticResource AccentSoftBrush}"
                        Visibility="Collapsed" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource ChipIcon}" Data="{StaticResource IconScissors}" Stroke="{StaticResource AccentTextBrush}" />
                        <TextBlock x:Name="TrimText" FontSize="12" Foreground="{StaticResource AccentTextBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Button x:Name="ResetTrim" Style="{StaticResource GhostButton}" Padding="8,4" Margin="4,0,0,0" FontSize="12"
                        Click="ResetTrim_Click" Visibility="Collapsed" ToolTip="Undo the trim (R)">
                    <TextBlock Text="Reset" Foreground="{StaticResource Text2Brush}" />
                </Button>
            </StackPanel>

            <StackPanel x:Name="Actions" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right"
                        Margin="16,0,0,0">
                <ToggleButton x:Name="AudioToggle" Style="{StaticResource ChipToggle}" IsChecked="True" Click="AudioToggle_Click"
                              ToolTip="Keep the sound in saved MP4s (M)">
                    <StackPanel Orientation="Horizontal">
                        <Path x:Name="AudioIcon" Style="{StaticResource ChipIcon}" Data="{StaticResource IconSpeaker}" />
                        <TextBlock x:Name="AudioText" Text="Sound on" />
                    </StackPanel>
                </ToggleButton>
                <Rectangle Style="{StaticResource VDivider}" Margin="10,0" />
                <ComboBox x:Name="GifSize" Width="128" SelectedIndex="1" ToolTip="GIF width">
                    <ComboBoxItem Content="GIF · 480 px" Tag="480" />
                    <ComboBoxItem Content="GIF · 720 px" Tag="720" />
                    <ComboBoxItem Content="GIF · 1080 px" Tag="1080" />
                    <ComboBoxItem Content="GIF · Original" Tag="0" />
                </ComboBox>
                <Button Margin="6,0,0,0" Click="Gif_Click" ToolTip="Save the clip as an animated GIF next to the video (Ctrl+G)">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource ChipIcon}" Data="{StaticResource IconSaveAs}" />
                        <TextBlock Text="Export GIF" />
                    </StackPanel>
                </Button>
                <Rectangle Style="{StaticResource VDivider}" Margin="10,0" />
                <Button Click="Copy_Click" ToolTip="Copy the video file (Ctrl+C)">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource ChipIcon}" Data="{StaticResource IconCopy}" />
                        <TextBlock Text="Copy" />
                    </StackPanel>
                </Button>
                <Button Margin="6,0,0,0" Click="SaveAs_Click" ToolTip="Save a copy as MP4 or GIF (Ctrl+Shift+S)">
                    <TextBlock Text="Save as…" />
                </Button>
                <!-- Save only once there's a trim (or sound change) to write; otherwise the recording is already saved -->
                <Grid Margin="8,0,0,0" VerticalAlignment="Center">
                    <Button x:Name="SaveButton" Style="{StaticResource AccentButton}" Click="Save_Click"
                            ToolTip="Apply the trim to the recording (Ctrl+S)" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource ChipIcon}" Data="{StaticResource IconSave}" Stroke="White" />
                            <TextBlock Text="Save" />
                        </StackPanel>
                    </Button>
                    <StackPanel x:Name="SavedLabel" Orientation="Horizontal" Margin="6,0,4,0" VerticalAlignment="Center" Background="Transparent">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconCheck}" Stroke="{StaticResource AccentTextBrush}" />
                        <TextBlock Text="Saved" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Text2Brush}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>
    </Grid>
</v:ChromeWindow>
