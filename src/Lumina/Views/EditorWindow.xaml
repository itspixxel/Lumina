<v:ChromeWindow x:Class="Lumina.Views.EditorWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:v="clr-namespace:Lumina.Views"
                xmlns:ed="clr-namespace:Lumina.Editor"
                Title="Lumina Editor" Width="1200" Height="800" MinWidth="760" MinHeight="480"
                WindowStartupLocation="CenterScreen" Icon="/Assets/lumina.ico"
                PreviewKeyDown="Window_PreviewKeyDown">
    <v:ChromeWindow.Resources>
        <Style x:Key="Tool" TargetType="RadioButton" BasedOn="{StaticResource ToolRadio}">
            <Setter Property="GroupName" Value="tools" />
        </Style>
        <Style x:Key="Swatch" TargetType="RadioButton">
            <Setter Property="GroupName" Value="colors" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="v:Fx.PressScale" Value="0.82" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Width="26" Height="26" Background="Transparent">
                            <Ellipse Stroke="{StaticResource TextBrush}" StrokeThickness="2" Opacity="0" v:Fx.ShowOpacity="0.35"
                                     v:Fx.Show="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Ellipse Stroke="{StaticResource TextBrush}" StrokeThickness="2" Opacity="0" v:Fx.ShowPop="True"
                                     v:Fx.Show="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Ellipse x:Name="Dot" Margin="5" Fill="{TemplateBinding Background}" Stroke="#40FFFFFF" StrokeThickness="1" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Dot" Property="Margin" Value="4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <LinearGradientBrush x:Key="RainbowBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF3B30" Offset="0" />
            <GradientStop Color="#FFCC00" Offset="0.25" />
            <GradientStop Color="#34C759" Offset="0.5" />
            <GradientStop Color="#0A84FF" Offset="0.75" />
            <GradientStop Color="#FF2D92" Offset="1" />
        </LinearGradientBrush>
        <Style x:Key="Chip" TargetType="RadioButton" BasedOn="{StaticResource ToolRadio}">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="v:Fx.PressScale" Value="0.94" />
        </Style>
        <Style x:Key="ChipToggle" TargetType="ToggleButton" BasedOn="{StaticResource ToolToggle}">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="v:Fx.PressScale" Value="0.94" />
        </Style>
        <Style x:Key="ChipIcon" TargetType="Path" BasedOn="{StaticResource Icon}">
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="LayoutTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="0.6" ScaleY="0.6" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="OptionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource Text2Brush}" />
        </Style>
    </v:ChromeWindow.Resources>

    <v:ChromeWindow.TitleBarContent>
        <StackPanel Orientation="Horizontal">
            <Button x:Name="UndoButton" Style="{StaticResource IconButton}" Click="Undo_Click" ToolTip="Undo (Ctrl+Z)">
                <Path Style="{StaticResource Icon}" Data="{StaticResource IconUndo}" />
            </Button>
            <Button x:Name="RedoButton" Style="{StaticResource IconButton}" Click="Redo_Click" ToolTip="Redo (Ctrl+Y)">
                <Path Style="{StaticResource Icon}" Data="{StaticResource IconRedo}" />
            </Button>
            <Rectangle Style="{StaticResource VDivider}" Margin="8,0" />
            <Button Style="{StaticResource GhostButton}" Click="Copy_Click" ToolTip="Copy (Ctrl+C)" Padding="10,6">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconCopy}" />
                    <TextBlock Text="Copy" Margin="7,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource GhostButton}" Click="SaveAs_Click" ToolTip="Save a copy somewhere else (Ctrl+Shift+S)" Padding="10,6" Margin="2,0">
                <TextBlock Text="Save as..." VerticalAlignment="Center" />
            </Button>
            <!-- Save while there's something to write; a quiet "Saved" once the file on disk is up to date -->
            <Grid Margin="6,0,0,0" VerticalAlignment="Center">
                <Button x:Name="SaveButton" Style="{StaticResource AccentButton}" Click="Save_Click" ToolTip="Save (Ctrl+S)" Padding="14,6">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconSave}" />
                        <TextBlock Text="Save" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <StackPanel x:Name="SavedLabel" Orientation="Horizontal" Margin="10,0,6,0" VerticalAlignment="Center" Visibility="Collapsed"
                            Background="Transparent">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconCheck}" Stroke="{StaticResource AccentTextBrush}" />
                    <TextBlock Text="Saved" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Text2Brush}" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </v:ChromeWindow.TitleBarContent>

    <Grid SizeChanged="Root_SizeChanged">
        <!-- Canvas -->
        <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      Background="{StaticResource DotGridBrush}" Focusable="False"
                      PreviewMouseWheel="Scroller_PreviewMouseWheel" SizeChanged="Scroller_SizeChanged">
            <Border x:Name="Stage" Margin="72,84,72,96" HorizontalAlignment="Center" VerticalAlignment="Center"
                    v:Fx.Entrance="True" v:Fx.EntranceOffset="0" v:Fx.EntranceScale="0.96" v:Fx.EntranceDelay="40"
                    Effect="{StaticResource FloatShadow}">
                <Border.LayoutTransform>
                    <ScaleTransform x:Name="ZoomTransform" />
                </Border.LayoutTransform>
                <ed:EditorCanvas x:Name="Canvas" />
            </Border>
        </ScrollViewer>

        <!-- Tools: select · draw · shapes · labels · effects · crop -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,14,0,0">
            <Border Style="{StaticResource Pill}" HorizontalAlignment="Center"
                    v:Fx.Entrance="True" v:Fx.EntranceOffset="-16" v:Fx.EntranceDelay="90">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="ToolSelect" Style="{StaticResource Tool}" Tag="Select" ToolTip="Select and move (V)" Checked="Tool_Checked">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconSelect}" />
                    </RadioButton>
                    <Rectangle Style="{StaticResource VDivider}" />
                    <RadioButton x:Name="ToolPen" Style="{StaticResource Tool}" Tag="Pen" ToolTip="Pen (P) · Shift for a straight line" Checked="Tool_Checked">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconPen}" />
                    </RadioButton>
                    <RadioButton x:Name="ToolHighlighter" Style="{StaticResource Tool}" Tag="Highlighter" ToolTip="Highlighter (H)" Checked="Tool_Checked">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconHighlighter}" />
                    </RadioButton>
                    <Rectangle Style="{StaticResource VDivider}" />
                    <RadioButton x:Name="ToolArrow" Style="{StaticResource Tool}" Tag="Arrow" ToolTip="Arrow (A) · Shift snaps to 45°" Checked="Tool_Checked">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconArrow}" />
                    </RadioButton>
                    <RadioButton x:Name="ToolLine" Style="{StaticResource Tool}" Tag="Line" ToolTip="Line (L) · Shift snaps to 45°" Checked="Tool_Checked">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconLine}" />
                    </RadioButton>
                    <RadioButton x:Name="ToolRectangle" Style="{StaticResource Tool}" Tag="Rectangle" ToolTip="Rectangle (R) · Shift for square" Checked="Tool_Checked">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconRect}" />
                    </RadioButton>
                    <RadioButton x:Name="ToolEllipse" Style="{StaticResource Tool}" Tag="Ellipse" ToolTip="Ellipse (E) · Shift for circle" Checked="Tool_Checked">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconEllipse}" />
                    </RadioButton>
                    <Rectangle Style="{StaticResource VDivider}" />
                    <RadioButton x:Name="ToolText" Style="{StaticResource Tool}" Tag="Text" ToolTip="Text (T) · Enter to finish, Shift+Enter for a new line" Checked="Tool_Checked">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconText}" />
                    </RadioButton>
                    <RadioButton x:Name="ToolStep" Style="{StaticResource Tool}" Tag="Step" ToolTip="Numbered steps (N)" Checked="Tool_Checked">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconStep}" />
                    </RadioButton>
                    <Rectangle Style="{StaticResource VDivider}" />
                    <RadioButton x:Name="ToolPixelate" Style="{StaticResource Tool}" Tag="Pixelate" ToolTip="Redact (B) · pixelate, blur or cover" Checked="Tool_Checked">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconPixelate}" />
                    </RadioButton>
                    <RadioButton x:Name="ToolSpotlight" Style="{StaticResource Tool}" Tag="Spotlight" ToolTip="Spotlight (S) · dims everything else" Checked="Tool_Checked">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconSpotlight}" />
                    </RadioButton>
                    <Rectangle Style="{StaticResource VDivider}" />
                    <RadioButton x:Name="ToolCrop" Style="{StaticResource Tool}" Tag="Crop" ToolTip="Crop (C) · double-click to reset" Checked="Tool_Checked">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconCrop}" />
                    </RadioButton>
                </StackPanel>
            </Border>

            <!-- Tool options: slides in under the toolbar for tools that have settings -->
            <Border x:Name="OptionsBar" Style="{StaticResource Pill}" HorizontalAlignment="Center" Margin="0,8,0,0" Padding="6,5"
                    Visibility="Collapsed">
                <Grid>
                    <StackPanel x:Name="PixelateOptions" Orientation="Horizontal" Visibility="Collapsed">
                        <RadioButton x:Name="RedactMosaic" Style="{StaticResource Chip}" GroupName="redact" Tag="Mosaic" Checked="Redact_Checked" IsChecked="True">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource ChipIcon}" Data="{StaticResource IconPixelate}" />
                                <TextBlock Text="Mosaic" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="RedactBlur" Style="{StaticResource Chip}" GroupName="redact" Tag="Blur" Checked="Redact_Checked">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource ChipIcon}" Data="{StaticResource IconBlur}" />
                                <TextBlock Text="Blur" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="RedactSolid" Style="{StaticResource Chip}" GroupName="redact" Tag="Solid" Checked="Redact_Checked"
                                     ToolTip="Covers the area with the current color">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource ChipIcon}" Data="{StaticResource IconSolid}" />
                                <TextBlock Text="Solid" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <StackPanel x:Name="StrengthGroup" Orientation="Horizontal">
                            <Rectangle Style="{StaticResource VDivider}" Margin="8,0" />
                            <TextBlock x:Name="StrengthLabel" Text="Block size" Style="{StaticResource OptionLabel}" />
                            <Slider x:Name="StrengthSlider" Width="120" Minimum="1" Maximum="10" Value="5" Margin="10,0,6,0"
                                    VerticalAlignment="Center" ValueChanged="Strength_Changed" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="SpotlightOptions" Orientation="Horizontal" Visibility="Collapsed">
                        <RadioButton x:Name="SpotRect" Style="{StaticResource Chip}" GroupName="spotshape" Checked="SpotShape_Checked" IsChecked="True" ToolTip="Rounded rectangle">
                            <Path Style="{StaticResource ChipIcon}" Data="{StaticResource IconRect}" Margin="0" />
                        </RadioButton>
                        <RadioButton x:Name="SpotEllipse" Style="{StaticResource Chip}" GroupName="spotshape" Checked="SpotShape_Checked" ToolTip="Ellipse">
                            <Path Style="{StaticResource ChipIcon}" Data="{StaticResource IconEllipse}" Margin="0" />
                        </RadioButton>
                        <Rectangle Style="{StaticResource VDivider}" Margin="8,0" />
                        <TextBlock Text="Darkness" Style="{StaticResource OptionLabel}" />
                        <Slider x:Name="DimSlider" Width="110" Minimum="0.15" Maximum="0.9" Value="0.6" Margin="10,0,6,0"
                                VerticalAlignment="Center" ValueChanged="Dim_Changed" />
                        <Rectangle Style="{StaticResource VDivider}" Margin="6,0" />
                        <ToggleButton x:Name="SpotBlur" Style="{StaticResource ChipToggle}" Click="SpotBlur_Click" ToolTip="Blur everything outside the spotlight">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource ChipIcon}" Data="{StaticResource IconBlur}" />
                                <TextBlock Text="Blur background" VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>

                    <StackPanel x:Name="CropOptions" Orientation="Horizontal" Visibility="Collapsed">
                        <RadioButton Style="{StaticResource Chip}" GroupName="aspect" Tag="Free" Content="Free" IsChecked="True" Click="Aspect_Click" />
                        <RadioButton Style="{StaticResource Chip}" GroupName="aspect" Tag="Original" Content="Original" Click="Aspect_Click" />
                        <RadioButton Style="{StaticResource Chip}" GroupName="aspect" Tag="1:1" Content="1:1" Click="Aspect_Click" />
                        <RadioButton Style="{StaticResource Chip}" GroupName="aspect" Tag="4:3" Content="4:3" Click="Aspect_Click" />
                        <RadioButton Style="{StaticResource Chip}" GroupName="aspect" Tag="3:2" Content="3:2" Click="Aspect_Click" />
                        <RadioButton Style="{StaticResource Chip}" GroupName="aspect" Tag="16:9" Content="16:9" Click="Aspect_Click" />
                        <RadioButton Style="{StaticResource Chip}" GroupName="aspect" Tag="9:16" Content="9:16" Click="Aspect_Click" />
                        <Rectangle Style="{StaticResource VDivider}" Margin="8,0" />
                        <Button Content="Reset" Padding="12,5" FontSize="12" Click="CropReset_Click" ToolTip="Back to the full image" />
                        <Button Style="{StaticResource AccentButton}" Content="Done" Padding="14,5" FontSize="12" Margin="6,0,0,0" Click="CropDone_Click" ToolTip="Apply (Enter)" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>

        <!-- Color and size -->
        <Border x:Name="ColorBar" Style="{StaticResource Pill}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18" Padding="10,6"
                v:Fx.Entrance="True" v:Fx.EntranceOffset="16" v:Fx.EntranceDelay="130">
            <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource Swatch}" Background="#FF3B30" ToolTip="Red" Checked="Color_Checked" IsChecked="True" />
                <RadioButton Style="{StaticResource Swatch}" Background="#FF9500" ToolTip="Orange" Checked="Color_Checked" />
                <RadioButton Style="{StaticResource Swatch}" Background="#FFCC00" ToolTip="Yellow" Checked="Color_Checked" />
                <RadioButton Style="{StaticResource Swatch}" Background="#34C759" ToolTip="Green" Checked="Color_Checked" />
                <RadioButton Style="{StaticResource Swatch}" Background="#0A84FF" ToolTip="Blue" Checked="Color_Checked" />
                <RadioButton Style="{StaticResource Swatch}" Background="#7C5CFF" ToolTip="Violet" Checked="Color_Checked" />
                <RadioButton Style="{StaticResource Swatch}" Background="#FF2D92" ToolTip="Pink" Checked="Color_Checked" />
                <RadioButton Style="{StaticResource Swatch}" Background="#111114" ToolTip="Black" Checked="Color_Checked" />
                <RadioButton Style="{StaticResource Swatch}" Background="#FFFFFF" ToolTip="White" Checked="Color_Checked" />
                <RadioButton x:Name="CustomSwatch" Style="{StaticResource Swatch}" Background="{StaticResource RainbowBrush}"
                             ToolTip="Custom color" Checked="Color_Checked" Click="CustomSwatch_Click" />
                <Popup x:Name="PickerPopup" PlacementTarget="{Binding ElementName=CustomSwatch}" Placement="Top" StaysOpen="False"
                       AllowsTransparency="True" PopupAnimation="None" HorizontalOffset="-128" VerticalOffset="-4">
                    <v:ColorPicker x:Name="Picker" />
                </Popup>
                <Rectangle Style="{StaticResource VDivider}" Margin="10,0" />
                <Grid Width="26" Height="26" VerticalAlignment="Center" ToolTip="Size">
                    <Ellipse x:Name="SizePreview" Width="6" Height="6" Fill="{StaticResource TextBrush}" />
                </Grid>
                <Slider x:Name="SizeSlider" Width="120" Margin="6,0,4,0" Minimum="1" Maximum="16" Value="4" VerticalAlignment="Center"
                        SmallChange="0.5" LargeChange="2" ValueChanged="Size_Changed" ToolTip="Size" />
                <TextBlock x:Name="SizeText" Width="26" TextAlignment="Right" VerticalAlignment="Center" FontSize="12"
                           Foreground="{StaticResource Text2Brush}" Text="4" />
            </StackPanel>
        </Border>

        <!-- Image size -->
        <Border x:Name="SizePill" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="18,0,0,24" CornerRadius="8" Padding="10,5"
                Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
            <TextBlock x:Name="StatusText" FontSize="12" Foreground="{StaticResource Text2Brush}" />
        </Border>

        <!-- Messages (copied, saved, and so on), above the color bar -->
        <v:Toast x:Name="Toast" VerticalAlignment="Bottom" Margin="24,0,24,72" />

        <!-- Zoom -->
        <Border x:Name="ZoomPill" Style="{StaticResource Pill}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,18,18" Padding="4"
                v:Fx.Entrance="True" v:Fx.EntranceOffset="16" v:Fx.EntranceDelay="170">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource IconButton}" Click="ZoomOut_Click" ToolTip="Zoom out (Ctrl+-)" Content="−" FontSize="15" Padding="10,3" />
                <TextBlock x:Name="ZoomText" Width="48" TextAlignment="Center" VerticalAlignment="Center" FontSize="12" />
                <Button Style="{StaticResource IconButton}" Click="ZoomIn_Click" ToolTip="Zoom in (Ctrl++)" Content="+" FontSize="15" Padding="10,3" />
                <Rectangle Style="{StaticResource VDivider}" Margin="2,0" />
                <RadioButton x:Name="FitButton" Style="{StaticResource ToolRadio}" GroupName="zoom" Click="Fit_Click" ToolTip="Fit to window (Ctrl+0)" Padding="7,5">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconFit}" />
                </RadioButton>
                <RadioButton x:Name="ActualButton" Style="{StaticResource ToolRadio}" GroupName="zoom" Click="ActualSize_Click" ToolTip="Actual size, 100% (Ctrl+1)" Padding="7,5">
                    <TextBlock Text="1:1" FontSize="12" FontWeight="SemiBold" Width="18" Height="18" TextAlignment="Center" Padding="0,1,0,0" />
                </RadioButton>
            </StackPanel>
        </Border>
    </Grid>
</v:ChromeWindow>
