<v:ChromeWindow x:Class="Lumina.Views.SettingsWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:v="clr-namespace:Lumina.Views"
                Title="Settings" Width="920" Height="740" MinWidth="740" MinHeight="460"
                WindowStartupLocation="CenterScreen" Icon="/Assets/lumina.ico">
    <v:ChromeWindow.Resources>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
            <Setter Property="FontSize" Value="{DynamicResource PageTitleSize}" />
            <Setter Property="TextOptions.TextFormattingMode" Value="{DynamicResource TitleTextMode}" />
            <Setter Property="TextOptions.TextRenderingMode" Value="{DynamicResource TitleRenderMode}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,0,0,0" />
        </Style>
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="GroupName" Value="nav" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Height="34">
                            <Border x:Name="Bd" CornerRadius="{DynamicResource RadiusControl}" Background="Transparent" />
                            <Border CornerRadius="{DynamicResource RadiusControl}" Background="{DynamicResource HoverBrush}" Opacity="0"
                                    v:Fx.Show="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" />
                            <ContentPresenter Margin="12,0" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FolderBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <!-- The template applies padding twice, so 16 lands the text just past the 28 px icon -->
            <Setter Property="Padding" Value="16,7,10,7" />
        </Style>
        <Style x:Key="FolderBoxIcon" TargetType="Path" BasedOn="{StaticResource Icon}">
            <Setter Property="Data" Value="{StaticResource IconFolder}" />
            <Setter Property="Stroke" Value="{DynamicResource Text2Brush}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="10,0,0,0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
    </v:ChromeWindow.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sections, and a search across all of them -->
        <StackPanel Grid.Column="0" Margin="16,4,16,0">
            <Grid Margin="0,0,0,12">
                <!-- The theme applies Padding twice (template margin and text view), so these are half the real insets. -->
                <TextBox x:Name="SearchBox" Padding="16,3,10,3" TextChanged="SearchBox_TextChanged" />
                <Path Style="{StaticResource Icon}" Data="{StaticResource IconSearch}" Stroke="{DynamicResource Text3Brush}"
                      HorizontalAlignment="Left" VerticalAlignment="Center" Margin="11,0,0,0" IsHitTestVisible="False">
                    <Path.LayoutTransform>
                        <ScaleTransform ScaleX="0.66" ScaleY="0.66" />
                    </Path.LayoutTransform>
                </Path>
                <!-- Starts a few px past where typed text (and the caret) begins, so the blinking caret never sits on the first letter. -->
                <TextBlock x:Name="SearchPlaceholder" Text="Find a setting" Foreground="{DynamicResource Text3Brush}"
                           VerticalAlignment="Center" Margin="38,0,10,0" IsHitTestVisible="False" />
            </Grid>
            <StackPanel x:Name="Nav">
                <RadioButton Style="{StaticResource NavItem}" Content="Shortcuts" Tag="Shortcuts" Checked="Nav_Checked" />
                <RadioButton Style="{StaticResource NavItem}" Content="Capture" Tag="Capture" Checked="Nav_Checked" />
                <RadioButton Style="{StaticResource NavItem}" Content="Recording" Tag="Recording" Checked="Nav_Checked" />
                <RadioButton Style="{StaticResource NavItem}" Content="After capture" Tag="AfterCapture" Checked="Nav_Checked" />
                <RadioButton Style="{StaticResource NavItem}" Content="Output" Tag="Output" Checked="Nav_Checked" />
                <RadioButton Style="{StaticResource NavItem}" Content="Sharing" Tag="Sharing" Checked="Nav_Checked" />
                <RadioButton Style="{StaticResource NavItem}" Content="Appearance" Tag="Appearance" Checked="Nav_Checked" />
                <RadioButton Style="{StaticResource NavItem}" Content="General" Tag="General" Checked="Nav_Checked" />
                <RadioButton Style="{StaticResource NavItem}" Content="About" Tag="About" Checked="Nav_Checked" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer x:Name="PageScroller" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Pages" Margin="8,4,32,32">

                <!-- ============ Shortcuts ============ -->
                <StackPanel x:Name="ShortcutsPage" Tag="Shortcuts">
                    <TextBlock Text="Shortcuts" Style="{StaticResource PageTitle}" />
                    <StackPanel Tag="group">
                        <TextBlock Text="Capture from anywhere" Style="{StaticResource SettingsGroupTitle}" />
                        <Border Style="{StaticResource SettingsCard}" Padding="18,8">
                            <v:ShortcutEditor />
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- ============ Capture ============ -->
                <StackPanel x:Name="CapturePage" Tag="Capture">
                    <TextBlock Text="Capture" Style="{StaticResource PageTitle}" />
                    <StackPanel Tag="group">
                        <TextBlock Text="While selecting" Style="{StaticResource SettingsGroupTitle}" />
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <Border Style="{StaticResource SettingsRow}">
                                    <CheckBox x:Name="ShowMagnifier">
                                        <StackPanel>
                                            <TextBlock Text="Magnifier" Style="{StaticResource SettingsRowTitle}" />
                                            <TextBlock Style="{StaticResource SettingsHint}" Text="Zoomed pixels, coordinates, and the color under the cursor." />
                                        </StackPanel>
                                    </CheckBox>
                                </Border>
                                <Border Style="{StaticResource SettingsRow}">
                                    <CheckBox x:Name="CaptureCursor">
                                        <TextBlock Text="Include the mouse pointer" Style="{StaticResource SettingsRowTitle}" />
                                    </CheckBox>
                                </Border>
                                <Border Style="{StaticResource SettingsRow}">
                                    <CheckBox x:Name="HideWindows">
                                        <StackPanel>
                                            <TextBlock Text="Hide Lumina while capturing" Style="{StaticResource SettingsRowTitle}" />
                                            <TextBlock Style="{StaticResource SettingsHint}" Text="Keeps Lumina's own windows out of the shot. Turn off to capture them too." />
                                        </StackPanel>
                                    </CheckBox>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- ============ Recording ============ -->
                <StackPanel x:Name="RecordingPage" Tag="Recording">
                    <TextBlock Text="Recording" Style="{StaticResource PageTitle}" />
                    <StackPanel Tag="group">
                        <TextBlock Text="Video" Style="{StaticResource SettingsGroupTitle}" />
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <Border Style="{StaticResource SettingsRow}">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                                            <Button x:Name="FfmpegDownload" Style="{StaticResource AccentButton}" Content="Download" Margin="8,0,0,0" Click="FfmpegDownload_Click" />
                                            <Button x:Name="FfmpegBrowse" Content="Browse" Margin="8,0,0,0" Click="FfmpegBrowse_Click" ToolTip="Use an ffmpeg.exe you already have" />
                                            <Button x:Name="FfmpegReset" Content="Reset" Margin="8,0,0,0" Click="FfmpegReset_Click" ToolTip="Stop using your own ffmpeg.exe" />
                                        </StackPanel>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="FFmpeg" Style="{StaticResource SettingsRowTitle}" />
                                            <TextBlock x:Name="FfmpegStatus" Style="{StaticResource SettingsHint}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource SettingsRow}">
                                    <DockPanel>
                                        <ComboBox x:Name="RecordingFps" Style="{StaticResource SettingsPick}">
                                            <ComboBoxItem Content="30 fps" Tag="30" />
                                            <ComboBoxItem Content="60 fps" Tag="60" />
                                            <ComboBoxItem Content="120 fps" Tag="120" />
                                            <ComboBoxItem Content="144 fps" Tag="144" />
                                        </ComboBox>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Frame rate" Style="{StaticResource SettingsRowTitle}" />
                                            <TextBlock Style="{StaticResource SettingsHint}" Text="Never more than the monitor's refresh rate." />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource SettingsRow}">
                                    <DockPanel>
                                        <ComboBox x:Name="RecordingCountdown" Style="{StaticResource SettingsPick}">
                                            <ComboBoxItem Content="None" Tag="0" />
                                            <ComboBoxItem Content="3 seconds" Tag="3" />
                                            <ComboBoxItem Content="5 seconds" Tag="5" />
                                        </ComboBox>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Countdown" Style="{StaticResource SettingsRowTitle}" />
                                            <TextBlock Style="{StaticResource SettingsHint}" Text="Before the recording starts." />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource SettingsRow}">
                                    <CheckBox x:Name="RecordCursor">
                                        <TextBlock Text="Show the mouse pointer in recordings" Style="{StaticResource SettingsRowTitle}" />
                                    </CheckBox>
                                </Border>
                                <Border Style="{StaticResource SettingsRow}">
                                    <CheckBox x:Name="HardwareEncoding">
                                        <StackPanel>
                                            <TextBlock Text="Use the graphics card to encode" Style="{StaticResource SettingsRowTitle}" />
                                            <TextBlock Style="{StaticResource SettingsHint}" Text="Lighter on the CPU when your GPU supports it (NVIDIA, Intel or AMD)." />
                                        </StackPanel>
                                    </CheckBox>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Tag="group">
                        <TextBlock Text="Sound" Style="{StaticResource SettingsGroupTitle}" />
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <Border Style="{StaticResource SettingsRow}">
                                    <CheckBox x:Name="RecordSystemAudio" Click="AudioCheck_Click">
                                        <StackPanel>
                                            <TextBlock Text="System audio" Style="{StaticResource SettingsRowTitle}" />
                                            <TextBlock Style="{StaticResource SettingsHint}" Text="Whatever plays through this output." />
                                        </StackPanel>
                                    </CheckBox>
                                </Border>
                                <Border x:Name="SystemDeviceRow" Style="{StaticResource SettingsRow}">
                                    <DockPanel>
                                        <ComboBox x:Name="SystemDevice" Style="{StaticResource SettingsPick}" />
                                        <TextBlock Text="Output device" Style="{StaticResource SettingsRowTitle}" VerticalAlignment="Center" Foreground="{DynamicResource Text2Brush}" />
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource SettingsRow}">
                                    <CheckBox x:Name="RecordMicrophone" Click="AudioCheck_Click">
                                        <StackPanel>
                                            <TextBlock Text="Microphone" Style="{StaticResource SettingsRowTitle}" />
                                            <TextBlock Style="{StaticResource SettingsHint}" Text="Your voice, from this input." />
                                        </StackPanel>
                                    </CheckBox>
                                </Border>
                                <Border x:Name="MicDeviceRow" Style="{StaticResource SettingsRow}">
                                    <DockPanel>
                                        <ComboBox x:Name="MicDevice" Style="{StaticResource SettingsPick}" />
                                        <TextBlock Text="Input device" Style="{StaticResource SettingsRowTitle}" VerticalAlignment="Center" Foreground="{DynamicResource Text2Brush}" />
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Tag="group">
                        <TextBlock Text="Files" Style="{StaticResource SettingsGroupTitle}" />
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <Border Style="{StaticResource SettingsRow}">
                                    <StackPanel>
                                        <TextBlock Text="Recordings folder" Style="{StaticResource SettingsRowTitle}" Margin="0,0,0,8" />
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Open" Margin="8,0,0,0" Click="OpenRecordingsFolder_Click" />
                                            <Button DockPanel.Dock="Right" Content="Browse" Margin="8,0,0,0" Click="BrowseRecordings_Click" />
                                            <Grid>
                                                <TextBox x:Name="RecordingsDirectory" Style="{StaticResource FolderBox}" />
                                                <Path Style="{StaticResource FolderBoxIcon}" />
                                            </Grid>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- ============ After capture ============ -->
                <StackPanel x:Name="AfterCapturePage" Tag="AfterCapture">
                    <TextBlock Text="After capture" Style="{StaticResource PageTitle}" />
                    <StackPanel Tag="group">
                        <TextBlock Text="Every capture" Style="{StaticResource SettingsGroupTitle}" />
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <Border Style="{StaticResource SettingsRow}">
                                    <CheckBox x:Name="CopyToClipboard">
                                        <StackPanel>
                                            <TextBlock Text="Copy to clipboard" Style="{StaticResource SettingsRowTitle}" />
                                            <TextBlock Style="{StaticResource SettingsHint}" Text="Screenshots, recordings and exported clips, ready to paste anywhere." />
                                        </StackPanel>
                                    </CheckBox>
                                </Border>
                                <Border Style="{StaticResource SettingsRow}">
                                    <CheckBox x:Name="AutoSave">
                                        <StackPanel>
                                            <TextBlock Text="Save screenshots to the output folder" Style="{StaticResource SettingsRowTitle}" />
                                            <TextBlock Style="{StaticResource SettingsHint}" Text="Recordings are always saved, to the recordings folder." />
                                        </StackPanel>
                                    </CheckBox>
                                </Border>
                                <Border Style="{StaticResource SettingsRow}">
                                    <DockPanel>
                                        <ComboBox x:Name="AfterScreenshot" Style="{StaticResource SettingsPick}" SelectionChanged="AfterScreenshot_Changed">
                                            <ComboBoxItem Content="Show a floating preview" Tag="preview" />
                                            <ComboBoxItem Content="Open the markup editor" Tag="editor" />
                                            <ComboBoxItem Content="Nothing" Tag="none" />
                                        </ComboBox>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="After a screenshot" Style="{StaticResource SettingsRowTitle}" />
                                            <TextBlock Style="{StaticResource SettingsHint}" Text="Recordings always open in the trim editor." />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Border x:Name="PreviewSecondsRow" Style="{StaticResource SettingsRow}">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Width="240" Margin="20,0,0,0" VerticalAlignment="Center">
                                            <Slider x:Name="PreviewSeconds" Width="190" Minimum="2" Maximum="30" IsSnapToTickEnabled="True" TickFrequency="1"
                                                    VerticalAlignment="Center" ValueChanged="PreviewSeconds_Changed" />
                                            <TextBlock x:Name="PreviewSecondsText" Width="46" VerticalAlignment="Center" TextAlignment="Right"
                                                       Foreground="{DynamicResource Text2Brush}" />
                                        </StackPanel>
                                        <TextBlock Text="Preview stays for" Style="{StaticResource SettingsRowTitle}" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- ============ Output ============ -->
                <StackPanel x:Name="OutputPage" Tag="Output">
                    <TextBlock Text="Output" Style="{StaticResource PageTitle}" />
                    <StackPanel Tag="group">
                        <TextBlock Text="Screenshots" Style="{StaticResource SettingsGroupTitle}" />
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <Border Style="{StaticResource SettingsRow}">
                                    <StackPanel>
                                        <TextBlock Text="Folder" Style="{StaticResource SettingsRowTitle}" Margin="0,0,0,8" />
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Open" Margin="8,0,0,0" Click="OpenFolder_Click" />
                                            <Button DockPanel.Dock="Right" Content="Browse" Margin="8,0,0,0" Click="Browse_Click" />
                                            <Grid>
                                                <TextBox x:Name="OutputDirectory" Style="{StaticResource FolderBox}" />
                                                <Path Style="{StaticResource FolderBoxIcon}" />
                                            </Grid>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SettingsRow}">
                                    <StackPanel>
                                        <TextBlock Text="File name" Style="{StaticResource SettingsRowTitle}" Margin="0,0,0,8" />
                                        <TextBox x:Name="FileNamePattern" TextChanged="Pattern_Changed" FontFamily="Cascadia Mono, Consolas" />
                                        <TextBlock x:Name="PatternPreview" Style="{StaticResource SettingsHint}" Margin="2,8,0,0" Foreground="{DynamicResource AccentTextBrush}" />
                                        <TextBlock x:Name="PatternHelp" Style="{StaticResource SettingsHint}" Margin="2,2,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SettingsRow}">
                                    <DockPanel>
                                        <ComboBox x:Name="ImageFormat" Style="{StaticResource SettingsPick}" SelectionChanged="Format_Changed">
                                            <ComboBoxItem Content="PNG - lossless" />
                                            <ComboBoxItem Content="JPEG - smaller" />
                                        </ComboBox>
                                        <TextBlock Text="Format" Style="{StaticResource SettingsRowTitle}" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>
                                <Border x:Name="QualityPanel" Style="{StaticResource SettingsRow}">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Width="240" Margin="20,0,0,0" VerticalAlignment="Center">
                                            <Slider x:Name="JpegQuality" Width="190" Minimum="40" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="1"
                                                    VerticalAlignment="Center" ValueChanged="Quality_Changed" />
                                            <TextBlock x:Name="QualityText" Width="46" VerticalAlignment="Center" TextAlignment="Right" Foreground="{DynamicResource Text2Brush}" />
                                        </StackPanel>
                                        <TextBlock Text="JPEG quality" Style="{StaticResource SettingsRowTitle}" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- ============ Sharing ============ -->
                <StackPanel x:Name="SharingPage" Tag="Sharing">
                    <TextBlock Text="Sharing" Style="{StaticResource PageTitle}" />
                    <StackPanel Tag="group">
                        <TextBlock Text="Get link" Style="{StaticResource SettingsGroupTitle}" />
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <Border Style="{StaticResource SettingsRow}">
                                    <DockPanel>
                                        <ComboBox x:Name="ShareExpiry" Style="{StaticResource SettingsPick}">
                                            <ComboBoxItem Content="1 hour" Tag="1" />
                                            <ComboBoxItem Content="1 day" Tag="24" />
                                            <ComboBoxItem Content="1 week" Tag="168" />
                                        </ComboBox>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Links expire after" Style="{StaticResource SettingsRowTitle}" />
                                            <TextBlock Style="{StaticResource SettingsHint}"
                                                       Text="Get link uploads a capture and copies a short link to it. Nothing is uploaded otherwise." />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource SettingsRow}">
                                    <DockPanel>
                                        <ComboBox x:Name="ShareServerKind" Style="{StaticResource SettingsPick}" SelectionChanged="ShareServerKind_Changed">
                                            <ComboBoxItem Content="Lumina's share server" />
                                            <ComboBoxItem Content="My own server" />
                                        </ComboBox>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Where files go" Style="{StaticResource SettingsRowTitle}" />
                                            <TextBlock x:Name="ShareServerHint" Style="{StaticResource SettingsHint}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Border x:Name="OwnServerPanel" Style="{StaticResource SettingsRow}">
                                    <StackPanel>
                                        <TextBlock Text="Server address" Style="{StaticResource SettingsRowTitle}" Margin="0,0,0,8" />
                                        <TextBox x:Name="ShareServer" />
                                        <TextBlock Text="Upload token (if your server needs one)" Style="{StaticResource SettingsRowTitle}" Margin="0,14,0,8" />
                                        <PasswordBox x:Name="ShareToken" PasswordChanged="ShareToken_Changed" />
                                        <TextBlock Style="{StaticResource SettingsHint}" Margin="2,8,0,0">
                                            Run your own copy on Cloudflare's free tier with the <Hyperlink Click="ShareGuide_Click">setup guide</Hyperlink>.
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- ============ Appearance ============ -->
                <StackPanel x:Name="AppearancePage" Tag="Appearance">
                    <TextBlock Text="Appearance" Style="{StaticResource PageTitle}" />
                    <v:AppearancePanel x:Name="Appearance" />
                </StackPanel>

                <!-- ============ General ============ -->
                <StackPanel x:Name="GeneralPage" Tag="General">
                    <TextBlock Text="General" Style="{StaticResource PageTitle}" />
                    <StackPanel Tag="group">
                        <TextBlock Text="Startup and updates" Style="{StaticResource SettingsGroupTitle}" />
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <Border Style="{StaticResource SettingsRow}">
                                    <CheckBox x:Name="StartWithWindows">
                                        <TextBlock Text="Start Lumina when you sign in" Style="{StaticResource SettingsRowTitle}" />
                                    </CheckBox>
                                </Border>
                                <Border Style="{StaticResource SettingsRow}">
                                    <CheckBox x:Name="AutoUpdate">
                                        <StackPanel>
                                            <TextBlock Text="Keep Lumina up to date" Style="{StaticResource SettingsRowTitle}" />
                                            <TextBlock Style="{StaticResource SettingsHint}" Text="Downloads new versions in the background and restarts into them when Lumina isn't in use." />
                                        </StackPanel>
                                    </CheckBox>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- ============ About ============ -->
                <StackPanel x:Name="AboutPage" Tag="About">
                    <TextBlock Text="About" Style="{StaticResource PageTitle}" />
                    <StackPanel Tag="group">
                        <TextBlock Text="Version" Style="{StaticResource SettingsGroupTitle}" />
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <Border Style="{StaticResource SettingsRow}">
                                    <DockPanel>
                                        <Button x:Name="UpdateButton" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="20,0,0,0" Click="UpdateButton_Click" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="VersionText" Style="{StaticResource SettingsRowTitle}" />
                                            <TextBlock x:Name="UpdateStatus" Style="{StaticResource SettingsHint}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource SettingsRow}">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Data folder" Style="{StaticResource SettingsRowTitle}" />
                                        <TextBlock Style="{StaticResource SettingsHint}">
                                            <Hyperlink Click="DataFolder_Click"><Run x:Name="DataFolderText" /></Hyperlink>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SettingsRow}">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Fonts" Style="{StaticResource SettingsRowTitle}" />
                                        <TextBlock Style="{StaticResource SettingsHint}"
                                                   Text="Inter, Geist, Newsreader, Nunito and Pixelify Sans, used under the SIL Open Font License 1.1." />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="NoResults" Visibility="Collapsed" Margin="2,40,0,0">
                    <TextBlock x:Name="NoResultsTitle" FontWeight="SemiBold" FontSize="14" />
                    <TextBlock Text="Try another word, like folder, sound or color." Style="{StaticResource SettingsHint}" Margin="0,4,0,0" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</v:ChromeWindow>
