<v:ChromeWindow x:Class="Lumina.Views.SettingsWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:v="clr-namespace:Lumina.Views"
                Title="Settings" Width="660" Height="780" MinWidth="540" MinHeight="440"
                WindowStartupLocation="CenterScreen" Icon="/Assets/lumina.ico">
    <v:ChromeWindow.Resources>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}" />
            <Setter Property="Margin" Value="4,22,0,10" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{StaticResource Text2Brush}" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="RowDivider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{StaticResource StrokeBrush}" />
            <Setter Property="Margin" Value="0,2" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="FolderBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Padding" Value="30,7,10,7" />
        </Style>
        <Style x:Key="FolderBoxIcon" TargetType="Path" BasedOn="{StaticResource Icon}">
            <Setter Property="Data" Value="{StaticResource IconFolder}" />
            <Setter Property="Stroke" Value="{StaticResource Text2Brush}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="10,0,0,0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
    </v:ChromeWindow.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,4,32,32">
            <TextBlock Text="Settings" FontFamily="{StaticResource DisplayFont}" FontSize="28" FontWeight="SemiBold" />

            <TextBlock Text="SHORTCUTS" Style="{StaticResource Section}" />
            <Border Style="{StaticResource Card}" Padding="18,6">
                <StackPanel>
                    <v:ShortcutEditor Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <TextBlock Text="CAPTURE" Style="{StaticResource Section}" />
            <Border Style="{StaticResource Card}" Padding="18,6">
                <StackPanel>
                    <CheckBox x:Name="ShowMagnifier">
                        <StackPanel>
                            <TextBlock Text="Magnifier" />
                            <TextBlock Style="{StaticResource Hint}" Text="Zoomed pixels, coordinates, and the color under the cursor." />
                        </StackPanel>
                    </CheckBox>
                    <Border Style="{StaticResource RowDivider}" />
                    <CheckBox x:Name="CaptureCursor">
                        <TextBlock Text="Include the mouse pointer" />
                    </CheckBox>
                    <Border Style="{StaticResource RowDivider}" />
                    <CheckBox x:Name="HideWindows">
                        <StackPanel>
                            <TextBlock Text="Hide Lumina while capturing" />
                            <TextBlock Style="{StaticResource Hint}" Text="Keeps Lumina's own windows out of the shot. Turn off to capture them too." />
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </Border>

            <TextBlock Text="RECORDING" Style="{StaticResource Section}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <!-- FFmpeg -->
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="FfmpegDownload" Style="{StaticResource AccentButton}" Content="Download" Margin="8,0,0,0" Click="FfmpegDownload_Click" />
                            <Button x:Name="FfmpegBrowse" Content="Browse" Margin="8,0,0,0" Click="FfmpegBrowse_Click" ToolTip="Use an ffmpeg.exe you already have" />
                            <Button x:Name="FfmpegReset" Content="Reset" Margin="8,0,0,0" Click="FfmpegReset_Click" ToolTip="Stop using your own ffmpeg.exe" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="FFmpeg" FontWeight="SemiBold" />
                            <TextBlock x:Name="FfmpegStatus" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource RowDivider}" Margin="0,14,0,6" />

                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,24,0">
                            <TextBlock Text="Frame rate" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="RecordingFps" Width="160">
                                <ComboBoxItem Content="30 fps" Tag="30" />
                                <ComboBoxItem Content="60 fps · smoother" Tag="60" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Countdown" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="RecordingCountdown" Width="140">
                                <ComboBoxItem Content="None" Tag="0" />
                                <ComboBoxItem Content="3 seconds" Tag="3" />
                                <ComboBoxItem Content="5 seconds" Tag="5" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Sound" Style="{StaticResource FieldLabel}" Margin="0,18,0,4" />
                    <DockPanel Margin="0,4,0,0">
                        <ComboBox x:Name="SystemDevice" DockPanel.Dock="Right" Width="260" Margin="20,0,0,0" VerticalAlignment="Center" />
                        <CheckBox x:Name="RecordSystemAudio" Click="AudioCheck_Click">
                            <StackPanel>
                                <TextBlock Text="System audio" />
                                <TextBlock Style="{StaticResource Hint}" Text="Whatever plays through this output." />
                            </StackPanel>
                        </CheckBox>
                    </DockPanel>
                    <DockPanel Margin="0,4,0,0">
                        <ComboBox x:Name="MicDevice" DockPanel.Dock="Right" Width="260" Margin="20,0,0,0" VerticalAlignment="Center" />
                        <CheckBox x:Name="RecordMicrophone" Click="AudioCheck_Click">
                            <StackPanel>
                                <TextBlock Text="Microphone" />
                                <TextBlock Style="{StaticResource Hint}" Text="Your voice, from this input." />
                            </StackPanel>
                        </CheckBox>
                    </DockPanel>
                    <Border Style="{StaticResource RowDivider}" Margin="0,8,0,2" />
                    <CheckBox x:Name="RecordCursor"><TextBlock Text="Show the mouse pointer in recordings" /></CheckBox>
                    <Border Style="{StaticResource RowDivider}" />
                    <CheckBox x:Name="HardwareEncoding">
                        <StackPanel>
                            <TextBlock Text="Use the graphics card to encode" />
                            <TextBlock Style="{StaticResource Hint}" Text="Lighter on the CPU when your GPU supports it (NVIDIA, Intel or AMD)." />
                        </StackPanel>
                    </CheckBox>

                    <TextBlock Text="Recordings folder" Style="{StaticResource FieldLabel}" Margin="0,14,0,8" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Open" Margin="8,0,0,0" Click="OpenRecordingsFolder_Click" />
                        <Button DockPanel.Dock="Right" Content="Browse" Margin="8,0,0,0" Click="BrowseRecordings_Click" />
                        <Grid>
                            <TextBox x:Name="RecordingsDirectory" Style="{StaticResource FolderBox}" />
                            <Path Style="{StaticResource FolderBoxIcon}" />
                        </Grid>
                    </DockPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="AFTER CAPTURE" Style="{StaticResource Section}" />
            <Border Style="{StaticResource Card}" Padding="18,6">
                <StackPanel>
                    <CheckBox x:Name="CopyToClipboard">
                        <StackPanel>
                            <TextBlock Text="Copy to clipboard" />
                            <TextBlock Style="{StaticResource Hint}" Text="Screenshots, recordings and exported clips, ready to paste anywhere." />
                        </StackPanel>
                    </CheckBox>
                    <Border Style="{StaticResource RowDivider}" />
                    <CheckBox x:Name="AutoSave">
                        <StackPanel>
                            <TextBlock Text="Save screenshots to the output folder" />
                            <TextBlock Style="{StaticResource Hint}" Text="Recordings are always saved, to the recordings folder." />
                        </StackPanel>
                    </CheckBox>
                    <Border Style="{StaticResource RowDivider}" />
                    <DockPanel Margin="0,12">
                        <ComboBox x:Name="AfterScreenshot" DockPanel.Dock="Right" Width="230" Margin="20,0,0,0" VerticalAlignment="Center"
                                  SelectionChanged="AfterScreenshot_Changed">
                            <ComboBoxItem Content="Show a floating preview" Tag="preview" />
                            <ComboBoxItem Content="Open the markup editor" Tag="editor" />
                            <ComboBoxItem Content="Nothing" Tag="none" />
                        </ComboBox>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="After a screenshot" />
                            <TextBlock Style="{StaticResource Hint}" Text="Recordings always open in the trim editor." />
                        </StackPanel>
                    </DockPanel>
                    <StackPanel x:Name="PreviewSecondsRow">
                        <Border Style="{StaticResource RowDivider}" />
                        <DockPanel Margin="0,12">
                            <TextBlock Text="Preview stays for" VerticalAlignment="Center" Width="140" />
                            <TextBlock x:Name="PreviewSecondsText" DockPanel.Dock="Right" Width="44" VerticalAlignment="Center" TextAlignment="Right"
                                       Foreground="{StaticResource Text2Brush}" />
                            <Slider x:Name="PreviewSeconds" Minimum="2" Maximum="30" IsSnapToTickEnabled="True" TickFrequency="1"
                                    VerticalAlignment="Center" ValueChanged="PreviewSeconds_Changed" />
                        </DockPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="OUTPUT" Style="{StaticResource Section}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Folder" Style="{StaticResource FieldLabel}" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Open" Margin="8,0,0,0" Click="OpenFolder_Click" />
                        <Button DockPanel.Dock="Right" Content="Browse" Margin="8,0,0,0" Click="Browse_Click" />
                        <Grid>
                            <TextBox x:Name="OutputDirectory" Style="{StaticResource FolderBox}" />
                            <Path Style="{StaticResource FolderBoxIcon}" />
                        </Grid>
                    </DockPanel>

                    <TextBlock Text="File name" Style="{StaticResource FieldLabel}" Margin="0,18,0,8" />
                    <TextBox x:Name="FileNamePattern" TextChanged="Pattern_Changed" FontFamily="Cascadia Mono, Consolas" />
                    <TextBlock x:Name="PatternPreview" Style="{StaticResource Hint}" Margin="2,8,0,0" Foreground="{StaticResource AccentTextBrush}" />
                    <TextBlock x:Name="PatternHelp" Style="{StaticResource Hint}" Margin="2,2,0,0" />

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,28,0">
                            <TextBlock Text="Format" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="ImageFormat" Width="160" SelectionChanged="Format_Changed">
                                <ComboBoxItem Content="PNG · lossless" />
                                <ComboBoxItem Content="JPEG · smaller" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" x:Name="QualityPanel">
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="JPEG quality" FontWeight="SemiBold" />
                                <TextBlock x:Name="QualityText" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="{StaticResource Text2Brush}" />
                            </DockPanel>
                            <Slider x:Name="JpegQuality" Minimum="40" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="1"
                                    ValueChanged="Quality_Changed" Margin="0,6,0,0" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Text="GENERAL" Style="{StaticResource Section}" />
            <Border Style="{StaticResource Card}" Padding="18,6">
                <CheckBox x:Name="StartWithWindows"><TextBlock Text="Start Lumina when you sign in" /></CheckBox>
            </Border>

            <TextBlock Text="ABOUT" Style="{StaticResource Section}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock x:Name="VersionText" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0">
                        Data folder: <Hyperlink Click="DataFolder_Click"><Run x:Name="DataFolderText" /></Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</v:ChromeWindow>
