<v:ChromeWindow x:Class="Lumina.Views.HomeWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:v="clr-namespace:Lumina.Views"
                Title="Lumina" Width="980" Height="700" MinWidth="760" MinHeight="500" PreviewKeyDown="Window_PreviewKeyDown"
                WindowStartupLocation="CenterScreen" Icon="/Assets/lumina.ico">
    <v:ChromeWindow.Resources>
        <!-- Capture modes along the toolbar, all alike at rest: nothing here is a selection, so nothing looks
             picked. The one under the pointer takes the accent fill, in the theme's depth (glow or ledge). In the
             Blocky depth the fill stays inside the outline and under the ledge, so the button itself changes color. -->
        <Style x:Key="ModeButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="36" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="12,0,14,0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource RadiusControl}" />
                            <Border Margin="{DynamicResource FillInset}" CornerRadius="{DynamicResource RadiusControl}" Background="{DynamicResource AccentFill}" Effect="{DynamicResource AccentGlow}"
                                    Opacity="0" v:Fx.Show="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Border Margin="{TemplateBinding BorderThickness}" BorderBrush="{DynamicResource BevelLightBrush}" BorderThickness="{DynamicResource BevelTop}" />
                            <Border Margin="{TemplateBinding BorderThickness}" BorderBrush="{DynamicResource BevelShadeBrush}" BorderThickness="{DynamicResource BevelBottom}" />
                            <Border Margin="{DynamicResource BevelFace}">
                                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ModeIcon" TargetType="Path" BasedOn="{StaticResource Icon}">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="LayoutTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="0.7" ScaleY="0.7" />
                </Setter.Value>
            </Setter>
        </Style>
    </v:ChromeWindow.Resources>

    <v:ChromeWindow.TitleBarContent>
        <StackPanel Orientation="Horizontal">
            <Button Style="{StaticResource IconButton}" Click="OpenFolder_Click" ToolTip="Open folder (Ctrl+E)">
                <Path Style="{StaticResource Icon}" Data="{StaticResource IconFolder}" />
            </Button>
            <Button Style="{StaticResource IconButton}" Click="Settings_Click" ToolTip="Settings (Ctrl+,)" Margin="2,0,0,0">
                <Path Style="{StaticResource Icon}" Data="{StaticResource IconSettings}" />
            </Button>
        </StackPanel>
    </v:ChromeWindow.TitleBarContent>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar: the capture modes, then the delay and opening an image -->
        <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource StrokeBrush}" Padding="24,4,24,14">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button x:Name="RegionCard" Style="{StaticResource ModeButton}" Tag="Region" Click="Mode_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource ModeIcon}" Data="{StaticResource IconRegion}" />
                            <TextBlock Text="Region" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="WindowCard" Style="{StaticResource ModeButton}" Tag="Window" Click="Mode_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource ModeIcon}" Data="{StaticResource IconWindow}" />
                            <TextBlock Text="Window" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ScreenCard" Style="{StaticResource ModeButton}" Tag="Screen" Click="Mode_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource ModeIcon}" Data="{StaticResource IconScreen}" />
                            <TextBlock Text="Full screen" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="FreeformCard" Style="{StaticResource ModeButton}" Tag="Freeform" Click="Mode_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource ModeIcon}" Data="{StaticResource IconFreeform}" />
                            <TextBlock Text="Freeform" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Rectangle Style="{StaticResource VDivider}" Margin="2,0,10,0" />
                    <Button x:Name="RecordCard" Style="{StaticResource ModeButton}" Click="Record_Click">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Fill="{DynamicResource DangerBrush}" Margin="2,0,9,0" VerticalAlignment="Center" />
                            <TextBlock Text="Record" VerticalAlignment="Center" />
                            <!-- "Set up" until FFmpeg is installed, the download progress, or that a recording is running -->
                            <Border x:Name="RecordBadge" CornerRadius="{DynamicResource RadiusItem}" Padding="6,1,7,1" Margin="9,0,0,0"
                                    VerticalAlignment="Center" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <Path x:Name="RecordBadgeIcon" Data="{StaticResource IconWarning}" StrokeThickness="2.2"
                                          Stroke="{Binding Foreground, ElementName=RecordBadgeText}"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="RecordBadgeText" Text="Set up" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Height="36" Click="OpenImage_Click"
                        ToolTip="Mark up any image file (Ctrl+O)">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource ModeIcon}" Data="{StaticResource IconImage}" />
                        <TextBlock Text="Open image" VerticalAlignment="Center" FontSize="13.5" />
                    </StackPanel>
                </Button>
                <ComboBox x:Name="DelayBox" DockPanel.Dock="Right" Width="132" Margin="0,0,6,0" VerticalAlignment="Center" SelectedIndex="0"
                          ToolTip="Wait before capturing, to open a menu or hover something first">
                    <ComboBoxItem Content="No delay" Tag="0" />
                    <ComboBoxItem Content="3 s delay" Tag="3" />
                    <ComboBoxItem Content="5 s delay" Tag="5" />
                    <ComboBoxItem Content="10 s delay" Tag="10" />
                </ComboBox>
            </DockPanel>
        </Border>

        <!-- Recent captures: the main thing on this screen -->
        <v:GalleryView x:Name="Gallery" Grid.Row="1" Margin="24,16,24,0" Limit="60" ShowViewAll="True" Title="Recent" />

        <!-- Handed to the gallery header in code: named elements can't live inside another control's content. -->
        <Grid x:Name="HeaderParts" Grid.Row="1" Visibility="Collapsed">
            <Grid x:Name="SubtitlePart">
                <Grid>
                    <StackPanel x:Name="ShortcutPanel" Orientation="Horizontal">
                        <StackPanel x:Name="ShortcutKeys" Orientation="Horizontal" Margin="-2,0,0,0" />
                        <TextBlock Text="captures a region from anywhere" Foreground="{DynamicResource Text3Brush}" FontSize="13"
                                   VerticalAlignment="Center" Margin="6,0,0,0" />
                    </StackPanel>
                    <TextBlock x:Name="ShortcutOffText" Text="No capture shortcut set. Add one in Settings." FontSize="13"
                               Foreground="{DynamicResource Text3Brush}" Visibility="Collapsed" />
                </Grid>
            </Grid>
            <Grid x:Name="SearchPart" Width="280">
                <!-- The theme applies Padding twice (template margin and text view), so these are half the real insets. -->
                <TextBox x:Name="SearchBox" Padding="18,4,17,4" TextChanged="SearchBox_TextChanged" />
                <Path Style="{StaticResource Icon}" Data="{StaticResource IconSearch}" Stroke="{DynamicResource Text3Brush}"
                      HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False">
                    <Path.LayoutTransform>
                        <ScaleTransform ScaleX="0.7" ScaleY="0.7" />
                    </Path.LayoutTransform>
                </Path>
                <!-- Starts a few px past where typed text (and the caret) begins, so the blinking caret never sits on the first letter. -->
                <TextBlock x:Name="SearchPlaceholder" Text="Search text in captures" Foreground="{DynamicResource Text3Brush}"
                           VerticalAlignment="Center" Margin="42,0,12,0" IsHitTestVisible="False" TextTrimming="CharacterEllipsis" />
            </Grid>
        </Grid>
    </Grid>
</v:ChromeWindow>
