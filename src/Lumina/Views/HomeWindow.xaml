<v:ChromeWindow x:Class="Lumina.Views.HomeWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:v="clr-namespace:Lumina.Views"
                Title="Lumina" Width="940" Height="660" MinWidth="720" MinHeight="500" PreviewKeyDown="Window_PreviewKeyDown"
                WindowStartupLocation="CenterScreen" Icon="/Assets/lumina.ico">
    <v:ChromeWindow.Resources>
        <Style x:Key="ModeCard" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="v:Fx.HoverLift" Value="3" />
            <Setter Property="v:Fx.PressScale" Value="0.97" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Height="128">
                            <Border CornerRadius="14" BorderThickness="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource StrokeBrush}" />
                            <Border CornerRadius="14" BorderThickness="1" Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource StrokeStrongBrush}"
                                    Opacity="0" v:Fx.Show="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" />
                            <ContentPresenter Margin="16,14" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryModeCard" TargetType="Button" BasedOn="{StaticResource ModeCard}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Height="128">
                            <Border CornerRadius="14" Background="{StaticResource AccentGradient}" />
                            <Border CornerRadius="14" Background="White" Opacity="0" v:Fx.ShowOpacity="0.1"
                                    v:Fx.Show="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" />
                            <ContentPresenter Margin="16,14" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IconTile" TargetType="Border">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource AccentTextBrush}" />
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
        <Style x:Key="CardCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Text2Brush}" />
        </Style>
    </v:ChromeWindow.Resources>

    <v:ChromeWindow.TitleBarContent>
        <StackPanel Orientation="Horizontal">
            <Button Style="{StaticResource IconButton}" Click="OpenFolder_Click" ToolTip="Open folder (Ctrl+E)">
                <Path Style="{StaticResource Icon}" Data="{StaticResource IconFolder}" />
            </Button>
            <Button Style="{StaticResource IconButton}" Click="Settings_Click" ToolTip="Settings (Ctrl+,)" Margin="2,0,0,0">
                <Path Style="{StaticResource Icon}" Data="{StaticResource IconSettings}" />
            </Button>
        </StackPanel>
    </v:ChromeWindow.TitleBarContent>

    <Grid Margin="32,12,32,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Hero -->
        <StackPanel Grid.Row="0" v:Fx.Entrance="True" v:Fx.EntranceOffset="8">
            <TextBlock Text="Capture anything" FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="SemiBold" />
            <StackPanel x:Name="ShortcutPanel" Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="Press" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <StackPanel x:Name="ShortcutKeys" Orientation="Horizontal" />
                <TextBlock Text="from anywhere, or pick a mode" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center" Margin="6,0,0,0" />
            </StackPanel>
            <TextBlock x:Name="ShortcutOffText" Text="No capture shortcut set. Add one in Settings."
                       Foreground="{StaticResource Text2Brush}" Margin="0,8,0,0" Visibility="Collapsed" />
        </StackPanel>

        <!-- Modes -->
        <Grid Grid.Row="1" Margin="0,24,-12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Style="{StaticResource PrimaryModeCard}" Tag="Region" x:Name="RegionCard" Click="Mode_Click" v:Fx.Entrance="True" v:Fx.EntranceDelay="60" v:Fx.EntranceOffset="18">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource IconTile}" Background="#33FFFFFF" TextElement.Foreground="White">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconRegion}" Stroke="White" />
                    </Border>
                    <StackPanel VerticalAlignment="Bottom">
                        <TextBlock Text="Region" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="Drag to select" Style="{StaticResource CardCaption}" Foreground="#DDFFFFFF" />
                    </StackPanel>
                </DockPanel>
            </Button>
            <Button Grid.Column="1" Style="{StaticResource ModeCard}" Tag="Window" x:Name="WindowCard" Click="Mode_Click" v:Fx.Entrance="True" v:Fx.EntranceDelay="105" v:Fx.EntranceOffset="18">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource IconTile}">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconWindow}" Stroke="{StaticResource AccentTextBrush}" />
                    </Border>
                    <StackPanel VerticalAlignment="Bottom">
                        <TextBlock Text="Window" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="Click any window" Style="{StaticResource CardCaption}" />
                    </StackPanel>
                </DockPanel>
            </Button>
            <Button Grid.Column="2" Style="{StaticResource ModeCard}" Tag="Screen" x:Name="ScreenCard" Click="Mode_Click" v:Fx.Entrance="True" v:Fx.EntranceDelay="150" v:Fx.EntranceOffset="18">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource IconTile}">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconScreen}" Stroke="{StaticResource AccentTextBrush}" />
                    </Border>
                    <StackPanel VerticalAlignment="Bottom">
                        <TextBlock Text="Full screen" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="Pick a monitor" Style="{StaticResource CardCaption}" />
                    </StackPanel>
                </DockPanel>
            </Button>
            <Button Grid.Column="3" Style="{StaticResource ModeCard}" Tag="Freeform" x:Name="FreeformCard" Click="Mode_Click" v:Fx.Entrance="True" v:Fx.EntranceDelay="195" v:Fx.EntranceOffset="18">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource IconTile}">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconFreeform}" Stroke="{StaticResource AccentTextBrush}" />
                    </Border>
                    <StackPanel VerticalAlignment="Bottom">
                        <TextBlock Text="Freeform" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="Draw any shape" Style="{StaticResource CardCaption}" />
                    </StackPanel>
                </DockPanel>
            </Button>
            <Button Grid.Column="4" Style="{StaticResource ModeCard}" Click="Record_Click" x:Name="RecordCard"
                    v:Fx.Entrance="True" v:Fx.EntranceDelay="240" v:Fx.EntranceOffset="18">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top">
                        <Border Style="{StaticResource IconTile}">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource IconRecord}" Stroke="{StaticResource AccentTextBrush}" />
                        </Border>
                        <!-- Shows "Set up" until FFmpeg is installed, the download progress, or that a recording is running -->
                        <Border x:Name="RecordBadge" HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="6" Padding="6,2,7,2"
                                Background="#33FFB020" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <Path x:Name="RecordBadgeIcon" Data="{StaticResource IconWarning}" Stroke="#FFC24D" StrokeThickness="2.2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="RecordBadgeText" Text="Set up" FontSize="11" Foreground="#FFC24D" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </DockPanel>
                    <StackPanel VerticalAlignment="Bottom">
                        <TextBlock Text="Record" Style="{StaticResource CardTitle}" />
                        <TextBlock x:Name="RecordCaption" Text="Video with sound" Style="{StaticResource CardCaption}" />
                    </StackPanel>
                </DockPanel>
            </Button>
        </Grid>

        <!-- Options -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,16,0,0" v:Fx.Entrance="True" v:Fx.EntranceDelay="260">
            <Path Style="{StaticResource Icon}" Data="{StaticResource IconTimer}" VerticalAlignment="Center" Stroke="{StaticResource Text2Brush}" />
            <TextBlock Text="Delay" VerticalAlignment="Center" Margin="6,0,10,0" Foreground="{StaticResource Text2Brush}" />
            <ComboBox x:Name="DelayBox" Width="120" SelectedIndex="0">
                <ComboBoxItem Content="None" Tag="0" />
                <ComboBoxItem Content="3 seconds" Tag="3" />
                <ComboBoxItem Content="5 seconds" Tag="5" />
                <ComboBoxItem Content="10 seconds" Tag="10" />
            </ComboBox>
            <Button Margin="10,0,0,0" Click="OpenImage_Click" ToolTip="Mark up any image file (Ctrl+O)">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconPen}" />
                    <TextBlock Text="Open image" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Gallery -->
        <v:GalleryView x:Name="Gallery" Grid.Row="3" Margin="0,30,0,0" Limit="60" ShowViewAll="True" Title="Recent" />
    </Grid>
</v:ChromeWindow>
