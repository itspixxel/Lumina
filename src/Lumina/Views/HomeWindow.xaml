<v:ChromeWindow x:Class="Lumina.Views.HomeWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:v="clr-namespace:Lumina.Views"
                Title="Lumina" Width="940" Height="660" MinWidth="720" MinHeight="500" PreviewKeyDown="Window_PreviewKeyDown"
                WindowStartupLocation="CenterScreen" Icon="/Assets/lumina.ico">
    <v:ChromeWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="ModeCard" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="v:Fx.HoverLift" Value="3" />
            <Setter Property="v:Fx.PressScale" Value="0.97" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Height="128">
                            <Border CornerRadius="14" BorderThickness="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource StrokeBrush}" />
                            <Border CornerRadius="14" BorderThickness="1" Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource StrokeStrongBrush}"
                                    Opacity="0" v:Fx.Show="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" />
                            <ContentPresenter Margin="16,14" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryModeCard" TargetType="Button" BasedOn="{StaticResource ModeCard}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Height="128">
                            <Border CornerRadius="14" Background="{StaticResource AccentGradient}" />
                            <Border CornerRadius="14" Background="White" Opacity="0" v:Fx.ShowOpacity="0.1"
                                    v:Fx.Show="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" />
                            <ContentPresenter Margin="16,14" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IconTile" TargetType="Border">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource AccentTextBrush}" />
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
        <Style x:Key="CardCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Text2Brush}" />
        </Style>
        <Style x:Key="ThumbButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="v:Fx.HoverLift" Value="3" />
            <Setter Property="v:Fx.PressScale" Value="0.97" />
            <Setter Property="Margin" Value="0,0,14,14" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Width="200">
                            <Border CornerRadius="12" BorderThickness="1"
                                    Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource StrokeBrush}" />
                            <Border CornerRadius="12" BorderThickness="1" Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource StrokeStrongBrush}"
                                    Opacity="0" v:Fx.Show="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Border CornerRadius="12" Background="{StaticResource AccentSoftBrush}" Opacity="0"
                                    v:Fx.Show="{Binding IsSelected}" />
                            <ContentPresenter Margin="7" />
                            <!-- Drawn on top so the 2px selected ring doesn't shift the content. -->
                            <Border CornerRadius="12" BorderThickness="2" BorderBrush="{StaticResource AccentBrush}"
                                    IsHitTestVisible="False" Opacity="0" v:Fx.Show="{Binding IsSelected}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- The round checkbox in a tile's corner: hidden until hover, or while anything is selected. -->
        <Style x:Key="SelectDot" TargetType="Border">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Margin" Value="8" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="#E6FFFFFF" />
            <Setter Property="Background" Value="#66000000" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="v:Fx.PressScale" Value="0.85" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                    <Setter Property="v:Fx.Show" Value="True" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                    <Setter Property="v:Fx.Show" Value="True" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#99000000" />
                    <Setter Property="BorderBrush" Value="White" />
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="v:Fx.Show" Value="True" />
                    <Setter Property="Background" Value="{StaticResource AccentGradient}" />
                    <Setter Property="BorderBrush" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </v:ChromeWindow.Resources>

    <v:ChromeWindow.TitleBarContent>
        <StackPanel Orientation="Horizontal">
            <Button Style="{StaticResource IconButton}" Click="OpenFolder_Click" ToolTip="Open captures folder">
                <Path Style="{StaticResource Icon}" Data="{StaticResource IconFolder}" />
            </Button>
            <Button Style="{StaticResource IconButton}" Click="Settings_Click" ToolTip="Settings" Margin="2,0,0,0">
                <Path Style="{StaticResource Icon}" Data="{StaticResource IconSettings}" />
            </Button>
        </StackPanel>
    </v:ChromeWindow.TitleBarContent>

    <Grid Margin="32,12,32,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Hero -->
        <StackPanel Grid.Row="0" v:Fx.Entrance="True" v:Fx.EntranceOffset="8">
            <TextBlock Text="Capture anything" FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="SemiBold" />
            <StackPanel x:Name="ShortcutPanel" Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="Press" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <Border Style="{StaticResource Keycap}"><TextBlock Text="Win" FontSize="11" FontWeight="SemiBold" /></Border>
                <Border Style="{StaticResource Keycap}"><TextBlock Text="Shift" FontSize="11" FontWeight="SemiBold" /></Border>
                <Border Style="{StaticResource Keycap}"><TextBlock Text="S" FontSize="11" FontWeight="SemiBold" /></Border>
                <TextBlock Text="from anywhere, or pick a mode" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center" Margin="6,0,0,0" />
            </StackPanel>
            <TextBlock x:Name="ShortcutOffText" Text="Capture shortcuts are off. Turn them on in Settings."
                       Foreground="{StaticResource Text2Brush}" Margin="0,8,0,0" Visibility="Collapsed" />
        </StackPanel>

        <!-- Modes -->
        <Grid Grid.Row="1" Margin="0,24,-12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Style="{StaticResource PrimaryModeCard}" Tag="Region" Click="Mode_Click" v:Fx.Entrance="True" v:Fx.EntranceDelay="60" v:Fx.EntranceOffset="18">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource IconTile}" Background="#33FFFFFF" TextElement.Foreground="White">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconRegion}" Stroke="White" />
                    </Border>
                    <StackPanel VerticalAlignment="Bottom">
                        <TextBlock Text="Region" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="Drag to select" Style="{StaticResource CardCaption}" Foreground="#DDFFFFFF" />
                    </StackPanel>
                </DockPanel>
            </Button>
            <Button Grid.Column="1" Style="{StaticResource ModeCard}" Tag="Window" Click="Mode_Click" v:Fx.Entrance="True" v:Fx.EntranceDelay="105" v:Fx.EntranceOffset="18">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource IconTile}">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconWindow}" Stroke="{StaticResource AccentTextBrush}" />
                    </Border>
                    <StackPanel VerticalAlignment="Bottom">
                        <TextBlock Text="Window" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="Click any window" Style="{StaticResource CardCaption}" />
                    </StackPanel>
                </DockPanel>
            </Button>
            <Button Grid.Column="2" Style="{StaticResource ModeCard}" Tag="Screen" Click="Mode_Click" v:Fx.Entrance="True" v:Fx.EntranceDelay="150" v:Fx.EntranceOffset="18">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource IconTile}">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconScreen}" Stroke="{StaticResource AccentTextBrush}" />
                    </Border>
                    <StackPanel VerticalAlignment="Bottom">
                        <TextBlock Text="Full screen" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="Pick a monitor" Style="{StaticResource CardCaption}" />
                    </StackPanel>
                </DockPanel>
            </Button>
            <Button Grid.Column="3" Style="{StaticResource ModeCard}" Tag="Freeform" Click="Mode_Click" v:Fx.Entrance="True" v:Fx.EntranceDelay="195" v:Fx.EntranceOffset="18">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource IconTile}">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconFreeform}" Stroke="{StaticResource AccentTextBrush}" />
                    </Border>
                    <StackPanel VerticalAlignment="Bottom">
                        <TextBlock Text="Freeform" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="Draw any shape" Style="{StaticResource CardCaption}" />
                    </StackPanel>
                </DockPanel>
            </Button>
            <Border Grid.Column="4" Margin="0,0,12,0" Height="128" CornerRadius="14" Padding="16,14" BorderThickness="1"
                    BorderBrush="{StaticResource StrokeBrush}" Background="Transparent"
                    ToolTip="Screen recording arrives in the next phase"
                    v:Fx.Entrance="True" v:Fx.EntranceDelay="240" v:Fx.EntranceOffset="18">
                <DockPanel Opacity="0.55">
                    <DockPanel DockPanel.Dock="Top">
                        <Border Style="{StaticResource IconTile}">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource IconRecord}" Stroke="{StaticResource AccentTextBrush}" />
                        </Border>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="6" Padding="7,2" Background="{StaticResource RaisedBrush}">
                            <TextBlock Text="Soon" FontSize="11" Foreground="{StaticResource Text2Brush}" />
                        </Border>
                    </DockPanel>
                    <StackPanel VerticalAlignment="Bottom">
                        <TextBlock Text="Record" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="Video and GIF" Style="{StaticResource CardCaption}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Options -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,16,0,0" v:Fx.Entrance="True" v:Fx.EntranceDelay="260">
            <Path Style="{StaticResource Icon}" Data="{StaticResource IconTimer}" VerticalAlignment="Center" Stroke="{StaticResource Text2Brush}" />
            <TextBlock Text="Delay" VerticalAlignment="Center" Margin="6,0,10,0" Foreground="{StaticResource Text2Brush}" />
            <ComboBox x:Name="DelayBox" Width="120" SelectedIndex="0">
                <ComboBoxItem Content="None" Tag="0" />
                <ComboBoxItem Content="3 seconds" Tag="3" />
                <ComboBoxItem Content="5 seconds" Tag="5" />
                <ComboBoxItem Content="10 seconds" Tag="10" />
            </ComboBox>
            <Button Margin="10,0,0,0" Click="OpenImage_Click" ToolTip="Mark up any image file">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconPen}" />
                    <TextBlock Text="Open image" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Recent -->
        <Grid Grid.Row="3" Margin="0,30,0,4" MinHeight="40">
            <TextBlock Text="Recent" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold"
                       VerticalAlignment="Center" HorizontalAlignment="Left" />
            <TextBlock x:Name="RecentHint" Text="Click to edit · Ctrl or Shift+click to select" FontSize="12"
                       VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{StaticResource Text3Brush}" />

            <!-- Selection actions, shown while anything is selected -->
            <Border x:Name="SelectionBar" Style="{StaticResource Pill}" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Padding="12,3,4,3" Visibility="Collapsed" Effect="{x:Null}">
                <StackPanel Orientation="Horizontal">
                    <Border Width="18" Height="18" CornerRadius="9" Background="{StaticResource AccentGradient}" VerticalAlignment="Center">
                        <Path Data="M5,9.5 L8,12.5 L13.5,6.5" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    </Border>
                    <TextBlock x:Name="SelectionText" Text="1 selected" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,10,0" />
                    <Rectangle Style="{StaticResource VDivider}" />
                    <Button Style="{StaticResource IconButton}" Click="SelectAll_Click" ToolTip="Select all (Ctrl+A)">
                        <TextBlock Text="All" FontSize="12" Margin="2,0" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Click="SelectionCopy_Click" ToolTip="Copy (Ctrl+C)">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconCopy}" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Click="SelectionFolder_Click" ToolTip="Show in folder">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconFolder}" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Click="SelectionDelete_Click" ToolTip="Move to Recycle Bin (Delete)"
                            Foreground="{StaticResource DangerBrush}">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconTrash}" />
                    </Button>
                    <Rectangle Style="{StaticResource VDivider}" />
                    <Button Style="{StaticResource IconButton}" Click="SelectionClear_Click" ToolTip="Clear selection (Esc)">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconClose}" />
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-12,0">
                <ItemsControl x:Name="RecentList" Margin="0,8,0,20" Tag="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource ThumbButton}" Click="Recent_Click" ToolTip="{Binding Name}"
                                    ContextMenuOpening="Recent_ContextMenuOpening">
                                <StackPanel>
                                    <Grid>
                                        <Border Height="112" CornerRadius="8" Background="{StaticResource WindowBrush}" ClipToBounds="True">
                                            <Image Source="{Binding Thumb}" Stretch="Uniform" Margin="2" RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Border>
                                        <Border Style="{StaticResource SelectDot}" PreviewMouseLeftButtonDown="SelectDot_MouseDown"
                                                ToolTip="Select · Ctrl+click to add, Shift+click for a range">
                                            <Path Data="M6.5,11.5 L9.5,14.5 L15,9" Stroke="White" StrokeThickness="2.2" Margin="-2,-2,0,0"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Opacity="0" v:Fx.ShowPop="True" v:Fx.Show="{Binding IsSelected}" />
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{Binding Name}" FontSize="12" Margin="4,8,4,0" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Info}" FontSize="11" Margin="4,1,4,4" Foreground="{StaticResource Text3Brush}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <StackPanel x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"
                    v:Fx.Entrance="True" v:Fx.EntranceDelay="200">
                <Border Width="56" Height="56" CornerRadius="16" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconRegion}" Stroke="{StaticResource AccentTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Your captures show up here" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,4" />
                <TextBlock Text="Take one with Win + Shift + S, or pick a mode above." Foreground="{StaticResource Text2Brush}" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</v:ChromeWindow>
