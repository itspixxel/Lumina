<Window x:Class="Lumina.Views.QuickPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lumina capture"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False" SizeToContent="WidthAndHeight"
        Opacity="0">
    <Window.Resources>
        <Style x:Key="PreviewButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Focusable" Value="False" />
        </Style>
    </Window.Resources>

    <Border x:Name="Card" Margin="18" CornerRadius="16" Padding="8" BorderThickness="1"
            Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource StrokeStrongBrush}"
            TextElement.Foreground="{StaticResource TextBrush}" TextElement.FontFamily="{StaticResource UiFont}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="4" Opacity="0.5" Direction="270" />
        </Border.Effect>
        <Border.RenderTransform>
            <TranslateTransform x:Name="Slide" Y="8" />
        </Border.RenderTransform>

        <StackPanel>
            <Grid>
                <Border CornerRadius="10" Cursor="Hand" Background="{StaticResource WindowBrush}" Padding="3"
                        ToolTip="Click to edit · drag into any app to share">
                    <Image x:Name="Thumb" MaxWidth="300" MaxHeight="190" MinWidth="120" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           PreviewMouseLeftButtonDown="Thumb_MouseDown"
                           PreviewMouseMove="Thumb_MouseMove"
                           PreviewMouseLeftButtonUp="Thumb_MouseUp" />
                </Border>
                <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0" Padding="4" Focusable="False"
                        Background="#B0101018" BorderBrush="Transparent" Foreground="White" Click="Close_Click" ToolTip="Dismiss">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconClose}" />
                </Button>
            </Grid>

            <DockPanel Margin="2,8,0,0" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock x:Name="TitleText" FontWeight="SemiBold" FontSize="12" />
                    <TextBlock x:Name="InfoText" FontSize="11" Foreground="{StaticResource Text2Brush}" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource PreviewButton}" Click="Copy_Click" ToolTip="Copy to clipboard">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconCopy}" />
                    </Button>
                    <Button x:Name="SaveButton" Style="{StaticResource PreviewButton}" Click="Save_Click">
                        <Path x:Name="SaveIcon" Style="{StaticResource Icon}" Data="{StaticResource IconSave}" />
                    </Button>
                    <Button Style="{StaticResource PreviewButton}" Click="Edit_Click" ToolTip="Mark up">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconPen}" />
                    </Button>
                    <Button Style="{StaticResource PreviewButton}" Click="Delete_Click" ToolTip="Move to Recycle Bin · Shift+click deletes permanently">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconTrash}" />
                    </Button>
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
