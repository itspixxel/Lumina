<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:v="clr-namespace:Lumina.Views">

    <!-- Colors, fonts, line weights, shadows and corner radii come from the palette that Services/Theme.cs
         builds and swaps in at runtime, so styles refer to them with DynamicResource. -->


    <!-- ============ Surfaces ============ -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource Line}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusCard}" />
        <Setter Property="Padding" Value="18,14" />
        <Setter Property="Effect" Value="{DynamicResource CardShadow}" />
    </Style>
    <Style x:Key="Pill" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StrokeStrongBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource Line}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusLarge}" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="Effect" Value="{DynamicResource FloatShadow}" />
    </Style>
    <Style x:Key="Keycap" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StrokeStrongBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource LineKey}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusKey}" />
        <Setter Property="Padding" Value="7,1,7,2" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="VDivider" TargetType="Rectangle">
        <Setter Property="Width" Value="1" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Margin" Value="6,0" />
        <Setter Property="Fill" Value="{DynamicResource StrokeStrongBrush}" />
    </Style>

    <!-- ============ Buttons ============ -->
    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource Line}" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="v:Fx.PressScale" Value="0.95" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource RadiusControl}" />
                        <Border CornerRadius="{DynamicResource RadiusControl}" Background="{DynamicResource HoverBrush}" Opacity="0"
                                v:Fx.Show="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" />
                        <Border CornerRadius="{DynamicResource RadiusControl}" Background="{DynamicResource PressedBrush}" Opacity="0"
                                v:Fx.Show="{Binding IsPressed, RelativeSource={RelativeSource TemplatedParent}}" />
                        <!-- Bevel: a lit top edge and a shaded bottom one, only in the Blocky depth (zero width otherwise). -->
                        <Border x:Name="BevelTop" Margin="{TemplateBinding BorderThickness}" BorderBrush="{DynamicResource BevelLightBrush}" BorderThickness="{DynamicResource BevelTop}" />
                        <Border x:Name="BevelBottom" Margin="{TemplateBinding BorderThickness}" BorderBrush="{DynamicResource BevelShadeBrush}" BorderThickness="{DynamicResource BevelBottom}" />
                        <!-- The label sits on the lit face, above the bottom ledge, not on the middle of the whole button. -->
                        <Border x:Name="Face" Margin="{DynamicResource BevelFace}">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                        <!-- Borderless buttons stay flat. -->
                        <Trigger Property="Background" Value="Transparent">
                            <Setter TargetName="BevelTop" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="BevelBottom" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Face" Property="Margin" Value="0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Padding" Value="7" />
    </Style>

    <Style x:Key="AccentButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="v:Fx.PressScale" Value="0.95" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border CornerRadius="{DynamicResource RadiusControl}" Background="{DynamicResource AccentFill}" Effect="{DynamicResource AccentGlow}" />
                        <Border CornerRadius="{DynamicResource RadiusControl}" Background="{DynamicResource OnAccentBrush}" Opacity="0" v:Fx.ShowOpacity="0.12"
                                v:Fx.Show="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" />
                        <Border BorderBrush="{DynamicResource BevelLightBrush}" BorderThickness="{DynamicResource BevelTop}" />
                        <Border BorderBrush="{DynamicResource BevelShadeBrush}" BorderThickness="{DynamicResource BevelBottom}" />
                        <Border Margin="{DynamicResource BevelFace}">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Destructive choices in dialogs ("Don't save", "Delete"). -->
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    </Style>

    <!-- Tool toggles (editor tools, capture modes) -->
    <Style x:Key="ToolToggle" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="8,7" />
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="v:Fx.PressScale" Value="0.88" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="{TemplateBinding Background}">
                        <Border CornerRadius="{DynamicResource RadiusControl}" Background="{DynamicResource HoverBrush}" Opacity="0"
                                v:Fx.Show="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" />
                        <Border CornerRadius="{DynamicResource RadiusControl}" Background="{DynamicResource AccentFill}" Opacity="0" v:Fx.ShowPop="True"
                                v:Fx.Show="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}" />
                        <!-- Blocky depth: the chosen one gets the same bottom ledge as buttons. -->
                        <Border BorderBrush="{DynamicResource BevelShadeBrush}" BorderThickness="{DynamicResource BevelBottom}" Opacity="0"
                                v:Fx.Show="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ToggleButton" BasedOn="{StaticResource ToolToggle}" />
    <Style x:Key="ToolRadio" TargetType="RadioButton" BasedOn="{StaticResource ToolToggle}" />
    <!-- Small pill choices (editor options, gallery filters) -->
    <Style x:Key="Chip" TargetType="RadioButton" BasedOn="{StaticResource ToolRadio}">
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="v:Fx.PressScale" Value="0.94" />
    </Style>

    <!-- ============ CheckBox as a switch ============ -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Padding" Value="0,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <DockPanel Background="Transparent" Margin="{TemplateBinding Padding}">
                        <Grid DockPanel.Dock="Right" Width="40" Height="22" VerticalAlignment="Center" Margin="16,0,0,0">
                            <Border x:Name="Track" CornerRadius="{DynamicResource RadiusPill}" Background="{DynamicResource RaisedBrush}"
                                    BorderBrush="{DynamicResource StrokeStrongBrush}" BorderThickness="{DynamicResource Line}" />
                            <Border CornerRadius="{DynamicResource RadiusPill}" Background="{DynamicResource AccentFill}" Opacity="0"
                                    v:Fx.Show="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Border x:Name="Knob" Width="14" Height="14" Margin="4,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                    CornerRadius="{DynamicResource RadiusPill}" Background="{DynamicResource Text2Brush}" />
                        </Grid>
                        <ContentPresenter VerticalAlignment="Center" />
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="Transparent" />
                            <Setter TargetName="Knob" Property="v:Fx.SlideX" Value="18" />
                            <Setter TargetName="Knob" Property="Background" Value="{DynamicResource OnAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ TextBox ============ -->
    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource Line}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource RadiusControl}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource StrokeStrongBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource Line}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource RadiusControl}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource StrokeStrongBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Slider ============ -->
    <Style x:Key="SliderFill" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Height="4" CornerRadius="{DynamicResource RadiusPill}" Background="{DynamicResource AccentFill}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SliderBlank" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Slider">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="v:SliderAssist.DragAnywhere" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Height="22" Background="Transparent">
                        <Border Height="4" CornerRadius="{DynamicResource RadiusPill}" Background="{DynamicResource StrokeStrongBrush}" VerticalAlignment="Center" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderFill}" Command="Slider.DecreaseLarge" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderBlank}" Command="Slider.IncreaseLarge" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid Width="16" Height="16" v:Fx.PressScale="1.25">
                                                <Border CornerRadius="{DynamicResource RadiusPill}" Background="{DynamicResource TextBrush}" />
                                                <Border x:Name="Ring" Margin="4" CornerRadius="{DynamicResource RadiusPill}" Background="{DynamicResource AccentBrush}" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Ring" Property="Margin" Value="3" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Scrolling ============ -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Background="Transparent">
                        <Border x:Name="Bd" CornerRadius="{DynamicResource RadiusPill}" Margin="3" Background="{DynamicResource ScrollThumbBrush}" />
                        <Border CornerRadius="{DynamicResource RadiusPill}" Margin="2" Background="{DynamicResource ScrollThumbHoverBrush}" Opacity="0"
                                v:Fx.Show="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="12" />
        <Setter Property="MinWidth" Value="12" />
        <!-- Scrollbars hug the window edge; without this the 6px resize border steals the mouse. -->
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}" /></Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="12" />
                <Setter Property="MinHeight" Value="12" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" IsDirectionReversed="False">
                                <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}" /></Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="ScrollViewer">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ScrollContentPresenter Margin="{TemplateBinding Padding}" CanContentScroll="{TemplateBinding CanContentScroll}" />
                        <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1"
                                   Value="{TemplateBinding VerticalOffset}" Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                        <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Row="1" Orientation="Horizontal"
                                   Value="{TemplateBinding HorizontalOffset}" Maximum="{TemplateBinding ScrollableWidth}"
                                   ViewportSize="{TemplateBinding ViewportWidth}" Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ ComboBox ============ -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Grid>
                        <Border x:Name="Bd" CornerRadius="{DynamicResource RadiusItem}" Background="Transparent" />
                        <Border CornerRadius="{DynamicResource RadiusItem}" Background="{DynamicResource HoverBrush}" Opacity="0"
                                v:Fx.Show="{Binding IsHighlighted, RelativeSource={RelativeSource TemplatedParent}}" />
                        <ContentPresenter Margin="10,7">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis" /></Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press" v:Fx.PressScale="1"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd" CornerRadius="{DynamicResource RadiusControl}" Background="{DynamicResource RaisedBrush}"
                                            BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="{DynamicResource Line}">
                                        <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" Data="M0,0 L4,4 L8,0"
                                              Stroke="{DynamicResource Text2Brush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round" RenderTransformOrigin="0.5,0.5">
                                            <Path.RenderTransform>
                                                <RotateTransform x:Name="Flip" />
                                            </Path.RenderTransform>
                                        </Path>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                            <!-- The chevron flips to point up while the list is open. -->
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="Flip" Storyboard.TargetProperty="Angle" To="180" Duration="0:0:0.2">
                                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="Flip" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.2">
                                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Margin="12,7,32,7" VerticalAlignment="Center" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis" /></Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                        <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="4" AllowsTransparency="True" Focusable="False"
                               PopupAnimation="None" IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                            <!-- The entrance animation scales the inner card, never the popup's own child: a popup
                                 positions itself using its child's transform, which would shift the list off the box. -->
                            <Grid Margin="0,0,10,10" Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border Padding="4" CornerRadius="{DynamicResource RadiusCard}"
                                        v:Fx.Entrance="True" v:Fx.EntranceOffset="-6" v:Fx.EntranceScale="0.97" RenderTransformOrigin="0.5,0"
                                        Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource StrokeStrongBrush}" BorderThickness="{DynamicResource Line}"
                                        Effect="{DynamicResource SoftShadow}">
                                    <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Menus and tooltips ============ -->
    <Style TargetType="ContextMenu">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Margin="10,6,14,16" Padding="5" MinWidth="196" CornerRadius="{DynamicResource RadiusCard}" Background="{DynamicResource RaisedBrush}"
                            BorderBrush="{DynamicResource StrokeStrongBrush}" BorderThickness="{DynamicResource Line}" Effect="{DynamicResource FloatShadow}"
                            v:Fx.Entrance="True" v:Fx.EntranceOffset="-6" v:Fx.EntranceScale="0.96">
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Margin="8,5" Background="{DynamicResource StrokeBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid MinHeight="34" Background="Transparent">
                        <Border CornerRadius="{DynamicResource RadiusItem}" Background="{DynamicResource HoverBrush}" Opacity="0"
                                v:Fx.Show="{Binding IsHighlighted, RelativeSource={RelativeSource TemplatedParent}}" />
                        <Grid Margin="9,0,10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter x:Name="IconHost" ContentSource="Icon" Width="18" Height="18" Margin="0,0,10,0"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
                            <TextBlock x:Name="Gesture" Grid.Column="2" Text="{TemplateBinding InputGestureText}" Margin="28,0,0,0" FontSize="12"
                                       Foreground="{DynamicResource Text3Brush}" VerticalAlignment="Center" />
                            <Path x:Name="Arrow" Grid.Column="3" Data="M0,0 L4,4 L0,8" Stroke="{DynamicResource Text2Brush}" StrokeThickness="1.5"
                                  Margin="16,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                            <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="0" VerticalOffset="-12" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="None"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border Margin="10,6,14,16" Padding="5" MinWidth="160" CornerRadius="{DynamicResource RadiusCard}" Background="{DynamicResource RaisedBrush}"
                                        BorderBrush="{DynamicResource StrokeStrongBrush}" BorderThickness="{DynamicResource Line}" Effect="{DynamicResource FloatShadow}"
                                        v:Fx.Entrance="True" v:Fx.EntranceOffset="0" v:Fx.EntranceScale="0.96">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                                </Border>
                            </Popup>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="InputGestureText" Value="">
                            <Setter TargetName="Gesture" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="True">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- A row in a hand-built popup list that should look like a menu entry. -->
    <Style x:Key="MenuRowButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid MinHeight="34" Background="Transparent">
                        <Border CornerRadius="{DynamicResource RadiusItem}" Background="{DynamicResource HoverBrush}" Opacity="0"
                                v:Fx.Show="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" />
                        <ContentPresenter Margin="9,0,10,0" VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Destructive menu entries (Delete). -->
    <Style x:Key="DangerMenuItem" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    </Style>
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Padding="9,5" CornerRadius="{DynamicResource RadiusItem}" Background="{DynamicResource RaisedBrush}"
                            BorderBrush="{DynamicResource StrokeStrongBrush}" BorderThickness="{DynamicResource Line}"
                            v:Fx.Entrance="True" v:Fx.EntranceOffset="4">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Hyperlink">
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
        <Setter Property="TextDecorations" Value="None" />
    </Style>

    <!-- ============ Window chrome ============ -->
    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
        <Setter Property="Width" Value="46" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Border Background="{DynamicResource HoverBrush}" Opacity="0"
                                v:Fx.Show="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Border Background="#E5334F" Opacity="0"
                                v:Fx.Show="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ChromeWindowStyle" TargetType="{x:Type v:ChromeWindow}">
        <Setter Property="Background" Value="{DynamicResource WindowFill}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="TextOptions.TextFormattingMode" Value="{DynamicResource TextMode}" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1"
                              CornerRadius="0" UseAeroCaptionButtons="False" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type v:ChromeWindow}">
                    <Border x:Name="Root" Background="{TemplateBinding Background}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="44" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" LastChildFill="False">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                                    <Image Source="/Assets/lumina.ico" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality" />
                                    <TextBlock Text="{TemplateBinding Title}" Margin="10,0,0,0" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <Button x:Name="PART_Close" DockPanel.Dock="Right" Style="{StaticResource CloseCaptionButton}" ToolTip="Close">
                                    <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" />
                                </Button>
                                <Button x:Name="PART_Maximize" DockPanel.Dock="Right" Style="{StaticResource CaptionButton}" ToolTip="Maximize">
                                    <Path x:Name="MaxGlyph" Data="M0.5,0.5 H9.5 V9.5 H0.5 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" />
                                </Button>
                                <Button x:Name="PART_Minimize" DockPanel.Dock="Right" Style="{StaticResource CaptionButton}" ToolTip="Minimize">
                                    <Path Data="M0,0.5 H10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" />
                                </Button>
                                <ContentPresenter DockPanel.Dock="Right" Margin="0,0,10,0" VerticalAlignment="Center"
                                                  Content="{TemplateBinding TitleBarContent}" WindowChrome.IsHitTestVisibleInChrome="True" />
                            </DockPanel>
                            <AdornerDecorator Grid.Row="1">
                                <ContentPresenter v:Fx.Entrance="True" v:Fx.EntranceOffset="10" />
                            </AdornerDecorator>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter TargetName="Root" Property="Padding" Value="7" />
                            <Setter TargetName="MaxGlyph" Property="Data" Value="M2.5,0.5 H9.5 V7.5 M0.5,2.5 H7.5 V9.5 H0.5 Z" />
                        </Trigger>
                        <Trigger Property="ResizeMode" Value="NoResize">
                            <Setter TargetName="PART_Maximize" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Settings rows (Settings window and its Appearance panel) ============ -->
    <!-- Group headings inside a page, in sentence case -->
    <Style x:Key="SettingsGroupTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
        <Setter Property="Margin" Value="2,22,0,8" />
    </Style>
    <Style x:Key="SettingsHint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>
    <Style x:Key="SettingsCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="18,0" />
    </Style>
    <!-- One setting: its words on the left, its control on the right. Lines between rows are set in code,
         so the first row of a card never has one (also after search hides rows). -->
    <Style x:Key="SettingsRow" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="0,12" />
        <Setter Property="MinHeight" Value="56" />
        <Style.Resources>
            <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                <Setter Property="Padding" Value="0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Style.Resources>
    </Style>
    <!-- Every dropdown in a row has the same width and sits on the same right-hand line. -->
    <Style x:Key="SettingsPick" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="Width" Value="240" />
        <Setter Property="Margin" Value="20,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="DockPanel.Dock" Value="Right" />
    </Style>
    <Style x:Key="SettingsRowTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13.5" />
    </Style>

    <!-- A preset in Settings, Appearance: a picture of the theme with its name under it. The one in use gets a
         ring that hugs the picture, a few px out, in the picture's own corner shape (Tag holds that radius). -->
    <Style x:Key="PresetTile" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="v:Fx.PressScale" Value="0.97" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Border x:Name="Ring" Height="{x:Static v:AppearancePanel.PreviewRingHeight}" VerticalAlignment="Top" Margin="-4,-4,-4,0"
                                CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                BorderThickness="2" BorderBrush="{DynamicResource AccentTextBrush}" Opacity="0"
                                v:Fx.Show="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}" />
                        <ContentPresenter />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
